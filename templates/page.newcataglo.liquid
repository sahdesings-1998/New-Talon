<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Responsive Image Grid</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <style>
   

    .container {
      max-width: 1200px;
      margin: auto;
    }

    .grid {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .image-box {
      flex: 1 1 calc(25% - 20px);
      min-width: 250px;
      position: relative;
      overflow: hidden;
      border-radius: var(--image-radius, 8px);
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    {% comment %} .image-box img {
      width: 100%;
      height: auto;
      display: block;
    } {% endcomment %}

    .image-box img {
  width: 100%;
  height: 100%;
  object-fit: fill;
}

    .overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
     
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.3s ease;
    }

    .overlay-btn {
      color: white;
      font-size: 16px;
      font-family: "Barlow Condensed", sans-serif;
      padding: 10px 25px;
      text-decoration: none;
      font-weight: 500;
      letter-spacing: 2px;
      border-radius: 30px;
      background-color: #00afcc;
      transition: background 0.3s ease;
    }

    .overlay-btn:hover {
      background-color: #424242;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .image-box {
        flex: 1 1 calc(50% - 20px);
      }
    }

    @media (max-width: 600px) {
      .image-box {
        flex: 1 1 100%;
      }
    }

    .heading-text{
        text-align: center;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1 class="heading-text" style="margin-top: 100px; font-family: Barlow Condensed, sans-serif; font-weight: 300; letter-spacing: 3px;">TALON ACTIVE</h1>
    <div class="grid" style="margin-top: 100px; margin-bottom: 200px;">
      <!-- Box 1 -->
      <div class="image-box">
        {% comment %} <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/fdc431cf0fe720f1a4532ddf5afd9cb2.jpg?v=1716883254" alt="TELON ACTIVE" /> {% endcomment %}
        <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/Untitled_design_3.jpg?v=1776149942" alt="TELON ACTIVE" />
        <div class="overlay">
          <a href="#" class="overlay-btn">TALON ACTIVE</a>
        </div>
      </div>

      <!-- Box 2 -->
      <div class="image-box">
        
        {% comment %} <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/5348f11d177f84da3b456f552ae64cf0.jpg?v=1716884252" alt="COMPRESSION" /> {% endcomment %}
        <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/Untitled_design_4.jpg?v=1776149941" alt="COMPRESSION" />
        <div class="overlay">
          <a href="#" class="overlay-btn">COMPRESSION</a>
        </div>
      </div>

      <!-- Box 3 -->
      <div class="image-box">
        {% comment %} <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/1b8427b2ec3c8e6d842b6068898fcc4d.jpg?v=1716880814" alt="ACCESSORIES" /> {% endcomment %}
        <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/Untitled_design.png?v=1776149942" alt="ACCESSORIES" />
        <div class="overlay">
          <a href="#" class="overlay-btn">ACCESSORIES</a>
        </div>
      </div>

      <!-- Box 4 -->
      <div class="image-box">
        {% comment %} <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/401622b1306502a13e119b8fe218efc7.jpg?v=1716883939" alt="TELON UMPIRE" /> {% endcomment %}
        <img src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/Untitled_design_2.jpg?v=1776149942" alt="TELON UMPIRE" />
        <div class="overlay">
          <a href="#" class="overlay-btn">TALON UMPIRE</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
