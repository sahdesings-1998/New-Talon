        "liquid": "<style>\n  /* Reset and global styles */\n  *, *::before, *::after {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n  }\n\n\n  body, html {\n    width: 100%;\n    overflow-x: hidden;\n    font-family: Arial, Helvetica, sans-serif;\n    line-height: 1.6;\n    color: #333;\n  }\n/* ================================\n   EXPERTISE CARDS\n================================= */\n.expertise-grid {\n  display: grid;\n  grid-template-columns: repeat(1, 1fr);\n  gap: 1.5rem;\n  max-width: 1200px;\n  margin: 2rem auto;\n  padding: 0 1rem;\n}\n\n.expertise-card {\n  background: #f9f9f9;\n  padding: 1rem;\n  color: #000;\n  display: flex;               /* ✅ make row layout */\n  align-items: center;         /* ✅ vertically center icon + text */\nflex-direction:column;\n  justify-content: center;     /* ✅ horizontally center the whole content */\n  gap: 1rem;                   /* ✅ spacing between icon and text */\n  text-align: left;           /* ✅ text aligned nicely */\n  box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n}\n\n.expertise-card img {\n  height: 80px;\n  width: 80px;\n  margin: 0; /* ✅ remove margin to align nicely */\n}\n\n.expertise-card h3 {\n  font-size: 1.2rem;\n  margin-bottom: 0.4rem;\n}\n\n.expertise-card p {\n  font-size: 0.95rem;\n  line-height: 1.5;\n}\n\n@media (max-width: 1024px) {\n  .expertise-grid {\n    grid-template-columns: repeat(, 1fr);\n  }\n}\n\n@media (max-width: 600px) {\n  .expertise-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .expertise-card {\n    flex-direction: column; /* ✅ stack vertically on small screens */\n    text-align: center;\n  }\n}\n\n\n  /* ================================\n     INTRO / HERO SECTION\n  ================================= */\n  .intro-section {\n    background-color: #fff;\n    padding: 4rem 1rem;\n    text-align: center;\n  }\n\n  .intro-title {\n    color: #000;\n    font-weight: 500;\n    font-family: \"Barlow Condensed\";\n    font-style: normal;\n    font-size: 35px;\n    line-height: 2em;\n    letter-spacing: 1px;\n  }\n\n  .intro-text {\n    color: #333;\n    margin-bottom: 20px;\n  }\n\n  /* ================================\n     VISION SECTION\n  ================================= */\n  .vision-section {\n    background-color: #000;\n    color: #ddd;\n    padding: 3rem 1rem;\n    text-align: center;\n  }\n\n  .vision-section h2 {\n    font-size: 2rem;\n    color: #fff;\n    margin-bottom: 1.5rem;\n  }\n\n  .vision-section p {\n    font-size: 1rem;\n    line-height: 1.6;\n    max-width: 900px;\n    margin: 0 auto 1rem;\n  }\n\n  /* ================================\n     EXPERTISE CARDS\n  ================================= */\n  .expertise-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 1.5rem;\n    max-width: 1200px;\n    margin: 2rem auto;\n    padding: 0 1rem;\n  }\n\n  .expertise-card {\n    background: #f9f9f9;\n    padding: 1.5rem;\n    color: #000;\n    text-align: center;\n    box-shadow: 0 4px 8px rgba(0,0,0,0.1);\n  }\n\n  .expertise-card img {\n    height: 100px;\n    width: 100px;\n    margin-bottom: 0.8rem;\n  }\n\n  .expertise-card h3 {\n    font-size: 1.2rem;\n    margin-bottom: 0.8rem;\n  }\n\n  .expertise-card p {\n    font-size: 0.95rem;\n    line-height: 1.5;\n  }\n\n  @media (max-width: 1024px) {\n    .expertise-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 600px) {\n    .expertise-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  /* ================================\n     CLIENT / WHO WE WORK WITH\n  ================================= */\n  .client-section {\n    width: 100%;\n    padding: 3rem 1rem;\n    text-align: center;\n  }\n\n  .client-heading {\n    font-size: 1.8rem;\n    margin-bottom: 1rem;\n    color: #111;\n  }\n\n  .client-subtext {\n    font-size: 1rem;\n    max-width: 900px;\n    margin: 0 auto 2rem;\n    color: #444;\n  }\n\n  .client-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 1rem;\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 1rem;\n  }\n\n  .client-card {\n    position: relative;\n    height: 300px;\n    background-size: cover;\n    background-position:center center;\nbackground-repeat:no-repeat;\n    display: flex;\n    align-items: flex-end;\n    overflow: hidden;\n  }\n\n  .client-card::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(0,0,0,0.6));\n  }\n\n  .client-card-content {\n    position: relative;\n    color: #fff;\n    padding: 1rem;\n    text-align: center;\n    width: 100%;\n  }\n\n  .client-card-content p {\n    font-size: 1rem;\n    text-transform: uppercase;\n    margin: 0;\n  }\n\n  @media (max-width: 1024px) {\n    .client-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media (max-width: 600px) {\n    .client-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  /* ================================\n     CORE DIVISIONS\n  ================================= */\n  .divisions-section {\n    text-align: left;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 3rem 1rem;\n  }\n\n  .divisions-section h2 {\n    text-transform: uppercase;\n    font-size: 1.8rem;\n    margin-bottom: 1rem;\n    text-align: center;\n  }\n\n  .divisions-section h3 {\n    font-size: 1.3rem;\n    margin: 1.5rem 0 0.5rem;\n  }\n\n  .divisions-section p {\n    font-size: 1rem;\n    line-height: 1.6;\n  }\n\n  /* ================================\n     PARTNERSHIP SECTION\n  ================================= */\n  .partnership-section {\n    width: 100%;\n    padding: 4rem 1rem;\n    background: #f4f4f4;\n    display: flex;\n    justify-content: center;\n  }\n\n  .partnership-row {\n    display: flex;\n    flex-wrap: wrap;\n    max-width: 1200px;\n    width: 100%;\n    justify-content: space-between;\n  }\n\n  .partnership-left,\n  .partnership-right {\n    flex: 0 0 45%;\n    padding: 1rem;\n    text-align: center;\n  }\n\n  .partnership-left h2 {\n    font-size: 2.8rem;\n    line-height: 1.2;\n    margin-bottom: 1rem;\n  }\n\n  .partnership-right p {\n    font-size: 1rem;\n    line-height: 1.6;\n    margin-bottom: 1rem;\n  }\n\n  @media (max-width: 768px) {\n    .partnership-left,\n    .partnership-right {\n      flex: 0 0 100%;\n    }\n\n    .partnership-left h2 {\n      font-size: 2rem;\n    }\n  }\n\n  /* ================================\n     CTA SECTION\n  ================================= */\n  .cta-section {\n    width: 100%;\n    padding: 3rem 1rem;\n    background: #fff;\n    text-align: center;\n  }\n\n  .cta-section h2 {\n    font-size: 1.8rem;\n    margin-bottom: 1rem;\n  }\n\n  .cta-section p {\n    font-size: 1rem;\n    margin-bottom: 1.5rem;\n  }\n\n  .cta-button {\n    display: inline-block;\n    padding: 0.8rem 1.5rem;\n    background: #01bdf7;\n    color: #fff;\n    border-radius: 10px;\n    font-weight: bold;\n    font-size: 1rem;\n    text-decoration: none;\n    transition: 0.3s;\n  }\n\n  .cta-button:hover {\n    background-color: #fff;\n    color: #01bdf7 !important;\n    border: 1px solid #01bdf7;\n  }\n</style>\n\n<!-- ==========================\n     HERO SECTION (full-res asset via talon-about-hero snippet)\n=========================== -->\n{%- render 'talon-about-hero' -%}\n\n<!-- ==========================\n     INTRO SECTION\n=========================== -->\n<section class=\"intro-section\" id=\"our-factory\">\n  <h1 class=\"intro-title\">About Talon Sportswear Manufacturer</h1>\n  <p class=\"intro-text\">\n    At Talon, we go beyond creating uniforms — we craft a powerful sense of identity. As one of Australia’s most trusted custom sportswear manufacturers, we proudly support schools, clubs, associations, and elite teams nationwide.\n  </p>\n  <p>\n    From grassroots beginnings to the highest levels of competition, we focus on delivering more — more durability, more innovation, more reliability, and deeper meaning in every piece we produce.\n  </p><br>\n  <p>\n    Driven by a passion for excellence, Talon manages every stage of production in-house — from initial concept and creative design to precision manufacturing and seamless delivery — ensuring quality that speaks for itself.\n  </p>\n</section>\n\n<!-- ==========================\n     VISION SECTION\n=========================== -->\n<section class=\"vision-section\">\n  <h2>Our Vision</h2>\n  <p>To transform the landscape of Australian sportswear through innovation, integrity, and purposeful design.</p>\n  <p>We believe a uniform is more than just apparel — it’s a symbol of pride, passion, and performance. Every garment we produce celebrates the story, spirit, and identity of the teams and schools that wear it. With sustainable materials, ethical manufacturing, and efficient delivery, Talon ensures every product performs both on and off the field.</p>\n\n  <div class=\"expertise-grid\" id=\"certifications\">\n    <div class=\"expertise-card\">\n      <img src=\"https://res.cloudinary.com/dgor3026n/image/upload/v1759819036/people_jcyof3.png\" alt=\"Expertise\">\n      <h3>Expertise</h3>\n      <p>We oversee the entire process — from concept to completion — with expert care across design, production, retail, logistics, and delivery.</p>\n    </div>\n    <div class=\"expertise-card\">\n      <img src=\"https://res.cloudinary.com/dgor3026n/image/upload/v1759819036/australia_yypjdq.png\" alt=\"Australian\">\n      <h3>Australian Owned</h3>\n      <p>Proudly Australian-owned and operated, Talon’s headquarters are in Sydney, with world-class production managed through our dedicated facility in China.</p>\n    </div>\n    <div class=\"expertise-card\">\n      <img src=\"https://res.cloudinary.com/dgor3026n/image/upload/v1759819036/innovation_eaocds.png\" alt=\"Innovation\">\n      <h3>Innovation</h3>\n      <p>We embrace cutting-edge solutions — from sustainable fabrics and smart technology to next-level personalisation and online ordering platforms.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ==========================\n     WHO WE WORK WITH\n=========================== -->\n<section class=\"client-section\">\n  <h2 class=\"client-heading\">Who We Work With</h2>\n  <p class=\"client-subtext\">\n    Talon partners with leading schools, clubs, and organisations nationwide — delivering exceptional quality, collaboration, and service at every level.\n  </p>\n\n  <div class=\"client-grid\">\n    <div class=\"client-card\" style=\"background-image: url('https://res.cloudinary.com/dgor3026n/image/upload/v1761054923/af-1_jqxwgd.png');\">\n      <div class=\"client-card-content\"><p>Schools & Educational Institutions</p></div>\n    </div>\n    <div class=\"client-card\" style=\"background-image: url('https://res.cloudinary.com/dgor3026n/image/upload/v1761057867/af-2-_kmyne2.png');\">\n      <div class=\"client-card-content\"><p>Community, State & Elite Sporting Clubs</p></div>\n    </div>\n    <div class=\"client-card\" style=\"background-image: url('https://res.cloudinary.com/dgor3026n/image/upload/v1761054923/af-3_rezbl1.png');\">\n      <div class=\"client-card-content\"><p>Pathway Programs & Professional Athletes</p></div>\n    </div>\n    <div class=\"client-card\" style=\"background-image: url('https://res.cloudinary.com/dgor3026n/image/upload/v1761054920/af-4_fxvlyf.png');\">\n      <div class=\"client-card-content\"><p>Government & Multi-Campus Organisations</p></div>\n    </div>\n  </div>\n</section>\n\n<!-- ==========================\n     CORE DIVISIONS\n=========================== -->\n<section class=\"divisions-section\" id=\"production-process\" style=\"text-align:center;\">\n  <h2>Our Core Divisions</h2>\n  <p>From junior competitions to elite performance, Talon delivers through three dedicated divisions.</p>\n\n  <h3>Retail & Events</h3>\n  <p>From event merchandise pop-ups to custom activation zones, we create immersive brand experiences that connect with athletes and fans alike.</p>\n\n  <h3>Wholesale</h3>\n  <p>We partner with clubs and associations to deliver premium, fully customised teamwear — engineered for performance, comfort, and consistency.</p>\n\n  <h3>School & Uniform Shops</h3>\n  <p>Our tailored solutions make outfitting students simple, with high-quality uniforms, seamless retail systems, and full shop management support.</p>\n</section>\n\n<!-- ==========================\n     PARTNERSHIP SECTION\n=========================== -->\n<section class=\"partnership-section\" id=\"sustainability\">\n  <div class=\"partnership-row\">\n    <div class=\"partnership-left\">\n      <h2>Let’s Design<br>Sportswear<br>That Inspires</h2>\n    </div>\n    <div class=\"partnership-right\">\n      <p>At Talon, we see ourselves as more than suppliers — we’re partners in performance. We understand the vision of school leaders, the dedication of local clubs, and the pride athletes feel when representing their team.</p>\n      <p>Whether reimagining your brand, launching a new program, or building a full-service retail model, Talon blends creativity, performance, and purpose to create sportswear that empowers every athlete.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ==========================\n     CTA SECTION\n=========================== -->\n<section class=\"cta-section\">\n  <h2>Ready to Elevate Your Team with Talon?</h2>\n  <p>Join the schools, clubs, and organisations across Australia that trust Talon to deliver sportswear designed for performance, passion, and pride.</p>\n  <a href=\"#\" class=\"button\">Meet Our Partners</a>\n</section>",
