{%- comment -%}
  Craft & Materials — compact capability catalog grid.
  Anchor id oem-details matches OEM nav dropdown.
{%- endcomment -%}

<section id="oem-details" class="oem-section oem-craft-section" aria-labelledby="oem-craft-heading">
  <header class="oem-craft-section__header">
    <h2 id="oem-craft-heading" class="oem-section-title">Craft &amp; Materials</h2>
    <p class="oem-craft-section__desc">
      We can make any crafts you need and use the materials you want according to the requirements, if you have any questions, please feel free to contact us!
    </p>
  </header>

  <div class="oem-craft-grid">
    {%- render 'talon-craft-showcase-card',
      label: 'Silicone Stamping',
      image: 'custom-apparel-silicone-stamping-technique.jpg',
      alt: 'Raised silicone stamping on navy sportswear showing TALON logo and dot pattern detail.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Sublimation Printing',
      image: 'all-over-sublimation-printing-fabric-pattern.jpg',
      alt: 'Detailed texture of a garment with vibrant, custom sublimation printing.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Digital Printing',
      image: 'direct-to-garment-digital-printing-service.jpg',
      alt: 'Vivid example of complex direct-to-garment digital printing results.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Embroidery Badge',
      image: 'custom-embroidered-logo-patch-badge.jpg',
      alt: 'TALON shield-shaped embroidered logo patch badge on navy sportswear fabric.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Heat-Seal Silicone',
      image: 'heat-press-applied-silicone-logo-transfer.jpg',
      alt: 'Durable heat-seal silicone transfer logo applied to red fabric.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Silicone Badge',
      image: 'raised-3d-silicone-rubber-clothing-badge-Black.jpeg',
      alt: 'Close-up of a raised, 3D silicone rubber badge on sportswear.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Chain Embroidery',
      image: 'chain-stitch-embroidery-texture-close-up.jpg',
      alt: 'TALON chain stitch embroidery close-up on black technical mesh sportswear fabric.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: '3D Embroidery',
      image: 'puffy-3d-embroidery-puff-stitch-logo.jpg',
      alt: 'Raised puff 3D embroidery TALON logo on grey hoodie sportswear.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Waterproof Zipper',
      image: 'waterproof-seam-sealed-garment-zipper.jpeg',
      alt: 'TALON raised silicone branding detail on black technical mesh sportswear fabric.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Waterproof Zipper',
      image: 'polyurethane-coated-water-resistant-zipper.jpg',
      alt: 'TALON polyurethane-coated waterproof zipper on teal technical sportswear with bonded seam.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Hidden Zipper',
      image: 'concealed-invisible-hidden-garment-zipper.jpg',
      alt: 'TALON concealed hidden zipper pocket on teal technical sportswear with lime accent trim.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Custom Zipper Puller',
      image: 'custom-branded-plastic-zipper-puller.jpg',
      alt: 'Custom branded plastic zipper puller cord on athletic apparel.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Jacquard Fabric',
      image: 'custom-jacquard-woven-pattern-fabric.jpg',
      alt: 'Intricate texture of custom jacquard woven pattern garment fabric.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Laser Cutting',
      image: 'precision-laser-cut-clothing-ventilation.jpg',
      alt: 'Precision laser cut ventilation holes on breathable athletic fabric.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Custom Elastic Band',
      image: 'custom-jacquard-elastic-waistband-sportswear.jpg',
      alt: 'Tonal jacquard custom elastic waistband with woven branding on teal sportswear.'
    -%}
    {%- render 'talon-craft-showcase-card',
      label: 'Breathable Material with Silver Band',
      image: 'waterproof-breathable-membrane-silver-lining.jpg',
      alt: 'Technical waterproof breathable membrane material with silver lining reflective band.'
    -%}
  </div>
</section>
