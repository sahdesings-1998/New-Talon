<section class="ee-section">

  <!--
    ═══════════════════════════════════════
         BREADCRUMB
    ═══════════════════════════════════════
  -->
  <div class="ee-container ee-breadcrumb-container">
    <nav class="ee-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="ee-breadcrumb-sep">/</span>
      <span class="ee-breadcrumb-current">{{ section.settings.page_title | default: 'Exhibitions & Events' }}</span>
    </nav>
  </div>

  <!--
    ═══════════════════════════════════════
         EXHIBITIONS & EVENTS — HERO
    ═══════════════════════════════════════
  -->
  <div class="ee-container ee-top-container" id="exhibitions-events">

    <h2 class="ee-section-heading">{{ section.settings.exhibitions_heading | default: 'Exhibitions & Events' }}</h2>

    <!-- Large Hero Image -->
    <div class="ee-hero-img">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1400 }}"
          alt="{{ section.settings.hero_image_alt | default: 'Exhibition' }}"
          loading="eager"
        >
      {% else %}
        <img
          src="https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1400&auto=format&fit=crop"
          alt="Exhibition"
        >
      {% endif %}
    </div>

    <!-- Secondary Medium Image -->
    <div class="ee-secondary-img">
      {% if section.settings.secondary_image != blank %}
        <img
          src="{{ section.settings.secondary_image | image_url: width: 1000 }}"
          alt="{{ section.settings.secondary_image_alt | default: 'Exhibition Event' }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="https://images.unsplash.com/photo-1528605248644-14dd04022da1?w=1000&auto=format&fit=crop"
          alt="Exhibition Event"
        >
      {% endif %}
    </div>

  </div>

  <!--
    ═══════════════════════════════════════
         FASHION TRENDS
    ═══════════════════════════════════════
  -->
  <div class="ee-container " id="fashion-trends">

    <h2 class="ee-section-heading">{{ section.settings.fashion_heading | default: 'Fashion Trends' }}</h2>

    <!-- 3-Column Image Grid -->
    <div class="ee-trends-grid">

      <div class="ee-trend-item">
        {% if section.settings.trend_image_1 != blank %}
          <img
            src="{{ section.settings.trend_image_1 | image_url: width: 600 }}"
            alt="{{ section.settings.trend_label_1 | default: 'Trend 1' }}"
            loading="lazy"
          >
        {% else %}
          <img
            src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&auto=format&fit=crop"
            alt="Fashion Trend 1"
          >
        {% endif %}
        {% if section.settings.trend_label_1 != blank %}
          <span class="ee-trend-label">{{ section.settings.trend_label_1 }}</span>
        {% endif %}
      </div>

      <div class="ee-trend-item">
        {% if section.settings.trend_image_2 != blank %}
          <img
            src="{{ section.settings.trend_image_2 | image_url: width: 600 }}"
            alt="{{ section.settings.trend_label_2 | default: 'Trend 2' }}"
            loading="lazy"
          >
        {% else %}
          <img
            src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=600&auto=format&fit=crop"
            alt="Fashion Trend 2"
          >
        {% endif %}
        {% if section.settings.trend_label_2 != blank %}
          <span class="ee-trend-label">{{ section.settings.trend_label_2 }}</span>
        {% endif %}
      </div>

      <div class="ee-trend-item">
        {% if section.settings.trend_image_3 != blank %}
          <img
            src="{{ section.settings.trend_image_3 | image_url: width: 600 }}"
            alt="{{ section.settings.trend_label_3 | default: 'Trend 3' }}"
            loading="lazy"
          >
        {% else %}
          <img
            src="https://images.unsplash.com/photo-1571513722275-4b41940f54b8?w=600&auto=format&fit=crop"
            alt="Fashion Trend 3"
          >
        {% endif %}
        {% if section.settings.trend_label_3 != blank %}
          <span class="ee-trend-label">{{ section.settings.trend_label_3 }}</span>
        {% endif %}
      </div>

    </div>
  </div>

  <!--
    ═══════════════════════════════════════
         SUPPLEMENTARY LESSONS / EXTRA SECTION
    ═══════════════════════════════════════
  -->
  <div class="ee-container ee-bottom-container" id="supplementary">

    <!-- 2-Column Image + Caption Grid -->
    <div class="ee-supp-grid">

      <div class="ee-supp-item">
        {% if section.settings.supp_image_1 != blank %}
          <img
            src="{{ section.settings.supp_image_1 | image_url: width: 700 }}"
            alt="{{ section.settings.supp_label_1 | default: '' }}"
            loading="lazy"
          >
        {% else %}
          <img
            src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=700&auto=format&fit=crop"
            alt="Supplementary 1"
          >
        {% endif %}
        {% if section.settings.supp_label_1 != blank %}
          <span class="ee-supp-label">{{ section.settings.supp_label_1 }}</span>
        {% endif %}
      </div>

      <div class="ee-supp-item">
        {% if section.settings.supp_image_2 != blank %}
          <img
            src="{{ section.settings.supp_image_2 | image_url: width: 700 }}"
            alt="{{ section.settings.supp_label_2 | default: '' }}"
            loading="lazy"
          >
        {% else %}
          <img
            src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=700&auto=format&fit=crop"
            alt="Supplementary 2"
          >
        {% endif %}
        {% if section.settings.supp_label_2 != blank %}
          <span class="ee-supp-label">{{ section.settings.supp_label_2 }}</span>
        {% endif %}
      </div>

    </div>
  </div>

</section>

<!-- ═══════════════════════════════════════════════════════
     STYLES
═══════════════════════════════════════════════════════ -->
<style>

  .ee-top-container{
  padding-top:0px !important;
  }

/* ════════════════════════════════════
   BASE & TOKENS
════════════════════════════════════ */
.ee-section {
  color: rgb(var(--text-color, 17 17 17));
}

:root {
  --ee-pad-x:     clamp(1.25rem, 3vw, 2.5rem);
  --ee-pad-y-top: clamp(3rem, 4.5vw, 3.5rem);
  --ee-pad-y-bot: clamp(3rem, 4.5vw, 3.5rem);
  --ee-grid-gap:  clamp(1.2rem, 2.5vw, 1.65rem);

   --ee-tab-y-top: clamp(2.125rem, 2rem + .6vw, 2.375rem);
  --ee-tab-y-bot: clamp(2.125rem, 2rem + .6vw, 2.375rem);

   --ee-mob-y-top: clamp(2rem, 1.9rem + .5vw, 2.125rem);
  --ee-mob-y-bot: clamp(2rem, 1.9rem + .5vw, 2.125rem);
  --ee-mob-x:     clamp(0.75rem, 5vw, 1rem);
}





/* ════════════════════════════════════
   CONTAINER
════════════════════════════════════ */
.ee-container {
  max-width: 1320px;
  margin: 0 auto;
  padding: var(--ee-pad-y-top) var(--ee-pad-x) var(--ee-pad-y-bot);
}

@media screen and (min-width: 1280px) {
  .ee-container {
    max-width: 1360px;
  }
}

@media screen and (max-width: 1024px) {
  :root {
    --ee-pad-x:     clamp(1.5rem, 3vw, 2rem);
    --ee-pad-y-top: clamp(2.5rem, 4vw, 3rem);
    --ee-pad-y-bot: clamp(2.5rem, 4vw, 3rem);
    --ee-grid-gap:  clamp(1rem, 2vw, 1.5rem);
  }
}



@media screen and (max-width: 900px) {
  :root {
    --ee-pad-x:     clamp(1.25rem, 3vw, 1.75rem);
    --ee-pad-y-top: clamp(2rem, 3.5vw, 2.5rem);
    --ee-pad-y-bot: clamp(2rem, 3.5vw, 2.5rem);
    --ee-grid-gap:  clamp(0.9rem, 2vw, 1.25rem);
  }
  /* existing rules stay */
}

/* ════════════════════════════════════
   BREADCRUMB
════════════════════════════════════ */
.ee-breadcrumb-container {
  padding-bottom: 0;
  padding-top:56px;
}

.ee-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom:clamp(1rem, 2vw, 1.5rem);
  gap: clamp(0.3rem, 1vw, 0.5rem);
  font-size: 18px;
  color: rgb(var(--text-color, 17 17 17) / 0.7);
  word-break: break-word;
}

.ee-breadcrumb a {
  color: inherit;
  text-decoration: none;
  transition: color 0.2s ease;
}

.ee-breadcrumb a:hover {
  color: rgb(var(--button-background, 0 0 0));
}

.ee-breadcrumb-current {
  color: rgb(var(--text-color, 17 17 17));
  font-weight: 500;
}

.ee-breadcrumb-sep {
  opacity: 0.6;
}

/* ════════════════════════════════════
   SECTION HEADING
════════════════════════════════════ */
.ee-section-heading {
  font-size: 30px;
      word-spacing: 2px;
  font-weight: bold;
  color: black;
  text-transform: uppercase;
  text-align: center;
  margin: 0 0 clamp(1rem, 2vw, 1.5rem);
  line-height: 1.3;
}

/* ════════════════════════════════════
   HERO IMAGE — full width, tall
════════════════════════════════════ */
.ee-hero-img {
  width: 100%;
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: clamp(0.75rem, 1.5vw, 1.25rem);
}

.ee-hero-img img {
  width: 100%;
  height: clamp(260px, 40vw, 520px);
  object-fit: cover;
  display: block;
  border-radius: 6px;
}

/* ════════════════════════════════════
   SECONDARY IMAGE — narrower, centered
════════════════════════════════════ */
.ee-secondary-img {
  {% comment %} width: 85%; {% endcomment %}
  margin: 0 auto;
  border-radius: 6px;
  overflow: hidden;
}

.ee-secondary-img img {
  width: 100%;
  height: clamp(260px, 40vw, 520px);
  object-fit: cover;
  display: block;
  border-radius: 6px;
}

/* ════════════════════════════════════
   FASHION TRENDS — 3-COL GRID
════════════════════════════════════ */

.ee-trends-grid {
  display: grid;
  grid-template-columns: calc(20% - var(--ee-grid-gap)) calc(60% - var(--ee-grid-gap)) calc(20%);
  gap: var(--ee-grid-gap);
  align-items: start; /* or center if you want vertical alignment */
}

.ee-trend-item img {
  width: 100%;
  height: clamp(200px, 36vw, 520px); /* same height for all 3 */
  object-fit: cover;
  display: block;
  border-radius: 6px;
}

{% comment %} .ee-trends-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--ee-grid-gap);
} {% endcomment %}

.ee-trend-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
  justify-content: center;
}

{% comment %} .ee-trend-item img {
  width: 100%;
  {% comment %} height: clamp(160px, 18vw, 280px); {% endcomment %}
  object-fit: cover;
  display: block;
  border-radius: 6px;
} {% endcomment %}

.ee-trend-label {
  display: block;
  font-size: 16px;
  font-weight: 500;
  color: black;
  line-height: 1.5;
  text-align: center;
  word-wrap: break-word;
}

/* ════════════════════════════════════
   SUPPLEMENTARY — 2-COL GRID
════════════════════════════════════ */
.ee-supp-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--ee-grid-gap);
}

.ee-supp-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.ee-supp-item img {
  width: 100%;
  height: clamp(180px, 26vw, 420px);
  object-fit: cover;
  display: block;
  border-radius: 6px;
}

.ee-supp-label {
  display: block;
  font-size: 16px;
  font-weight: 500;
  color: black;
  line-height: 1.5;
  text-align: center;
  word-wrap: break-word;
  text-transform: uppercase;
}

/* ════════════════════════════════════
   RESPONSIVE — 900px
════════════════════════════════════ */
@media screen and (max-width: 900px) {
  .ee-section-heading {
    font-size: clamp(20px, 3vw, 26px);
  }

  .ee-secondary-img {
    width: 95%;
  }
}




/* ════════════════════════════════════
   RESPONSIVE — 768px
════════════════════════════════════ */
@media screen and (max-width: 768px) {
  :root {
  --ee-pad-x:     clamp(1rem, 4vw, 1.5rem);
  --ee-pad-y-top: clamp(2.125rem, 2rem + .6vw, 2.375rem);
  --ee-pad-y-bot: clamp(2.125rem, 2rem + .6vw, 2.375rem);
}

.ee-breadcrumb-container{

  padding-top:var(--ee-tab-y-top) !important;
  padding-bottom:0px !important;
}
.ee-container {
  padding: var(--ee-tab-y-top) var(--ee-pad-x) var(--ee-tab-y-bot);
}


  .ee-section-heading {
    font-size: clamp(18px, 4vw, 24px);
  }

  .ee-secondary-img {
    width: 100%;
  }

  {% comment %} .ee-trends-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.5rem, 2vw, 0.75rem);
  } {% endcomment %}

  .ee-breadcrumb {
    font-size: clamp(13px, 2vw, 15px);
  }

  .ee-trend-label,
  .ee-supp-label {
    font-size: clamp(12px, 2vw, 14px);
  }
   .ee-trends-grid {
    grid-template-columns: 1fr 2fr 1fr;
  }

  .ee-trend-item img {
   height: clamp(120px, 36vw, 260px);
  }

  .ee-trend-label {
    font-size: 13px;
  }
}

/* ════════════════════════════════════
   RESPONSIVE — 600px
════════════════════════════════════ */
@media screen and (max-width: 600px) {
  :root {
  --ee-pad-x:     clamp(0.9rem, 4.5vw, 1.25rem);
  --ee-pad-y-top: clamp(1.5rem, 4.5vw, 2rem);
  --ee-pad-y-bot: clamp(1.5rem, 4.5vw, 2rem);
  --ee-grid-gap:  clamp(0.75rem, 3vw, 1rem);
}

  .ee-section-heading {
    font-size: clamp(16px, 4.5vw, 20px);
  }

  .ee-hero-img img {
    height: clamp(200px, 55vw, 280px);
  }

  .ee-secondary-img img {
    height: clamp(160px, 45vw, 240px);
  }

  .ee-trends-grid {
    grid-template-columns: 1fr;
  }

  .ee-supp-grid {
    grid-template-columns: 1fr;
  }

  .ee-trend-item img,
  .ee-supp-item img {
    height: 220px;
  }
}

@media screen and (max-width: 480px) {
  :root {
    --ee-pad-x:     clamp(0.75rem, 5vw, 1rem);
    --ee-pad-y-top: clamp(2rem, 1.9rem + .5vw, 2.125rem);
    --ee-pad-y-bot: clamp(2rem, 1.9rem + .5vw, 2.125rem);
    --ee-grid-gap:  clamp(0.65rem, 3.5vw, 0.9rem);
  }
  /* existing rules */
}

/* ════════════════════════════════════
   RESPONSIVE — 480px
════════════════════════════════════ */
@media screen and (max-width: 480px) {

  
  .ee-breadcrumb-container{

  padding-top:var(--ee-mob-y-top) !important;
}
.ee-container {
  padding: var(--ee-mob-y-top) var(--ee-mob-x) var(--ee-mob-y-bot);
}

  .ee-section-heading {
    font-size: clamp(15px, 5vw, 20px);
    letter-spacing: 0.03em;
  }

  .ee-hero-img img {
    height: 200px;
  }

  .ee-secondary-img img {
    height: 200px;
  }

  {% comment %} .ee-trends-grid {
    grid-template-columns: 1fr;
  } {% endcomment %}

  .ee-supp-item img {
    height: 190px;
  }

    .ee-trends-grid {
    grid-template-columns: 1fr;
  }

  .ee-trend-item img {
    height: clamp(180px, 60vw, 300px);
  }

  .ee-trend-label {
    font-size: 14px;
  }
  .ee-breadcrumb-container {
    padding-bottom: 0;
    padding-top: 26px;
}
}

@media screen and (max-width: 380px) {
  :root {
    --ee-pad-x:     0.75rem;
    --ee-pad-y-top: 1.25rem;
    --ee-pad-y-bot: 1.25rem;
    --ee-grid-gap:  0.6rem;
  }
}

</style>

