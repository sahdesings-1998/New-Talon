    {% comment %}
      <section class="oem-section" id="oem-rfq">
        <h2 class="oem-section-title">RFQ / Enquiry Form</h2>
        {%- liquid
          assign oem_rfq_image = 'start-custom-sportswear-manufacturing-project.jpg'
          assign oem_rfq_alt = 'Factory workers inspecting finished custom team wear jerseys in apparel factory.'
          assign oem_rfq_sizes = '(min-width: 769px) min(600px, 45vw), 100vw'
        -%}
        <div class="oem-rfq">
          <article class="oem-rfq-panel">
            <div class="oem-rfq-panel__media">
              {%- render 'talon-oem-asset-image',
                asset: oem_rfq_image,
                alt: oem_rfq_alt,
                sizes: oem_rfq_sizes,
                preset: 'large',
                width: 2048,
                height: 1364,
                loading: 'lazy'
              -%}
            </div>
            <div class="oem-rfq-panel__content">
              <h3>Start Your Custom Manufacturing Project</h3>
              <p>Share your requirement and our OEM team will review specifications and respond with a production-ready quotation.</p>
              <ul class="oem-rfq-trust">
                <li>Response within 24 hours</li>
                <li>Low MOQ support</li>
                <li>Worldwide shipping available</li>
                <li>Dedicated OEM production support</li>
              </ul>
            </div>
          </article>

          {% form 'contact', id: 'oem-rfq-contact-form', return_to: request.path %}
            <input type="hidden" name="contact[tags]" value="oem-odm-rfq">
            {%- if form.posted_successfully? -%}
              <div class="oem-rfq-success" role="status" aria-live="polite">
                <div class="oem-rfq-success__inner">
                  <div class="oem-rfq-success__icon" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="48" height="48" aria-hidden="true" focusable="false">
                      <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.25" opacity="0.35"/>
                      <path d="M15 24.5 22.5 31.5 34 17" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <h3 class="oem-rfq-success__title">Enquiry submitted successfully</h3>
                  <p class="oem-rfq-success__text">Our OEM team will contact you shortly.</p>
                </div>
              </div>
            {%- else -%}
              <div class="oem-rfq-form-fields">
                <div class="oem-rfq-form__head">
                  <h3>Request Custom Quote</h3>
                  <p>Complete the form below to receive pricing, MOQ, and timeline details.</p>
                </div>
                {{ form.errors | default_errors }}
                {%- if settings.oem_turnstile_site_key != blank -%}
                  <p id="oem-turnstile-error" class="oem-turnstile-error" role="alert" hidden></p>
                {%- endif -%}
                <div class="oem-form-grid">
                  <input type="text" name="contact[name]" placeholder="Name" required>
                  <input type="email" name="contact[email]" placeholder="Email" autocomplete="email" required>
                  <input type="text" name="contact[company]" placeholder="Company Name" required>
                  <input type="text" name="contact[whatsapp]" placeholder="WhatsApp Number" required>
                  <input type="text" name="contact[country]" placeholder="Country" required>
                  <input type="text" name="contact[product_type]" placeholder="Product Type" required>
                  <input type="text" name="contact[moq]" placeholder="MOQ / Quantity" required>
                  <input type="text" name="contact[fabric_type]" placeholder="Fabric Type" required>

                  <textarea class="oem-field-full" name="contact[body]" placeholder="Message" required></textarea>
                  {%- if settings.oem_turnstile_site_key != blank -%}
                    <div
                      id="oem-turnstile-mount"
                      class="oem-turnstile-mount oem-field-full"
                      data-sitekey="{{ settings.oem_turnstile_site_key | escape }}"
                      data-widget="{{ settings.oem_turnstile_widget | default: 'invisible' | escape }}"
                    ></div>
                  {%- endif -%}
                  <button class="button oem-btn oem-btn--primary oem-field-full" type="submit">Start Your Project</button>
                </div>
              </div>
            {%- endif -%}
          {% endform %}
        </div>
      </section>
    {% endcomment %}

    {% comment %}
      <section class="oem-section" id="faq">
        <h2 class="oem-section-title">FAQ</h2>
        <div class="oem-faq">
          <details>
            <summary>What is your MOQ for OEM sportswear and bulk sportswear production?</summary>
            <p>MOQ depends on product type, fabric, and customization level. We support low MOQ starts and scalable bulk sportswear production plans.</p>
          </details>
          <details>
            <summary>Do you provide samples before bulk production?</summary>
            <p>Yes. We provide sample development for fit, fabric, print, and branding approval before confirming mass production.</p>
          </details>
          <details>
            <summary>What printing methods do you offer for custom jerseys and activewear?</summary>
            <p>We offer sublimation, embroidery, screen printing, heat transfer, and DTF printing based on design needs and order volume.</p>
          </details>
          <details>
            <summary>Can you create private label activewear under ODM apparel manufacturing?</summary>
            <p>Yes. We support ODM apparel manufacturing with private label services including neck labels, woven labels, hang tags, and branded packaging.</p>
          </details>
          <details>
            <summary>What is the production lead time after sample approval?</summary>
            <p>Lead time varies by quantity and complexity. Once sample approval is complete, we provide a clear production and dispatch timeline.</p>
          </details>
          <details>
            <summary>Do you ship internationally for OEM and ODM orders?</summary>
            <p>Yes. We ship globally with export-ready packing and documentation support for international B2B buyers.</p>
          </details>
          <details>
            <summary>Can I customize packaging, labels, and accessories for my brand?</summary>
            <p>Absolutely. We support packaging customization, branded labels, zipper pulls, and accessory details for full private label execution.</p>
          </details>
          <details>
            <summary>What file formats do you accept for logos and artwork?</summary>
            <p>Preferred formats are AI, EPS, PDF, PNG, and high-resolution JPG. Our team can guide you if file cleanup is needed before production.</p>
          </details>
          <p class="oem-faq__support">Need help with your project scope? Contact our OEM support team on <a href="https://api.whatsapp.com/send/?phone=8615976011860&text&type=phone_number&app_absent=0" target="_blank" rel="noopener">WhatsApp</a>.</p>
        </div>
      </section>
    {% endcomment %}

    {%- comment -%} Downloads — hidden temporarily (set oem_show_downloads true to restore) {%- endcomment -%}
