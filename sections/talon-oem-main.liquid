        {% comment %} oem capability new css {% endcomment %}

        .oem-capability-section .oem-media-card{
          display:grid;
          grid-template-columns:1fr 1fr;
          align-items:center;
          background:#fff;
          overflow:visible;
          gap:30px;
          {% comment %} border-bottom:1px solid #d9d9d9; {% endcomment %}
          padding-bottom:35px;
        }

        /* Alternate layout (per major capability section) */
        .oem-capability-section--reverse .oem-media-card__media {
          order: 1;
        }

        .oem-capability-section--reverse .oem-media-card__body {
          order: 2;
        }

        .oem-capability-section:not(.oem-capability-section--reverse) .oem-media-card__media {
          order: 2;
        }

        .oem-capability-section:not(.oem-capability-section--reverse) .oem-media-card__body {
          order: 1;
        }

        /* Image — wrapper clips radius; img matches token for object-fit / lazy-load */
        .oem-capability-section .oem-media-card__media {
          width: 100%;
          min-width: 0;
          border-radius: var(--image-radius, 8px);
          overflow: hidden;
          isolation: isolate;
        }

        .oem-capability-section .oem-media-card__media :is(img, picture) {
          width: 100%;
          height: 100%;
          display: block;
          object-fit: cover;
          border-radius: var(--image-radius, 8px);
        }

        .oem-capability-section .oem-media-card__media picture img {
          border-radius: var(--image-radius, 8px);
        }

        /* Content */
        .oem-media-card__body{
          padding:10px 0;
        }

        .oem-media-card__body h3{
          {% comment %} font-size:20px;
          font-weight:700;
          margin:0 0 14px;
          color:#111;
          line-height:1.3; {% endcomment %}
