<div class="oem-page">
  <div class="oem-wrap">
    {%- liquid
      comment
        Toggle supplementary OEM informational sections (restore by setting true):
        - Why Work With Talon (#why-work-talon)
        - OEM / ODM Service Details (#oem-details)
        - Why Choose Talon (#why-choose-talon)
      endcomment
      assign oem_show_supplementary_sections = false
      assign oem_show_downloads = false
    -%}

    {%- liquid
      assign oem_hero_image = 'custom-sportswear-manufacturing-factory-banner.jpg'
      assign oem_hero_alt = 'Custom sportswear manufacturing factory for OEM ODM and private label solutions'
      assign oem_hero_sizes = '(min-width: 769px) min(1320px, 100vw), 100vw'
    -%}
    {% comment %}
      <section class="oem-hero" id="oem-overview">
        {%- render 'talon-oem-asset-image',
          asset: oem_hero_image,
          alt: oem_hero_alt,
          sizes: oem_hero_sizes,
          preset: 'hero',
          width: 2048,
          height: 1364,
          class: 'oem-hero__image',
          loading: 'eager',
          fetchpriority: 'high'
        -%}
        <div class="oem-hero__content">
          <h1>Custom Sportswear Manufacturing</h1>
          <p class="oem-hero__sub">OEM • ODM • Private Label Solutions</p>
          <p class="oem-hero__support">Low MOQ • Fast Sampling • Worldwide Shipping</p>
          <div class="oem-actions">
            <a class="button oem-btn oem-btn--primary" href="#oem-rfq">Start Your Project</a>
            <a class="button oem-btn oem-btn--ghost" href="/files/Talon-OEM-ODM-Catalog.pdf" target="_blank" rel="noopener">Download Catalog</a>
          </div>
          <ul class="oem-hero__trust" aria-label="OEM trust indicators">
            <li>Low MOQ</li>
            <li>Factory Direct</li>
            <li>Global Shipping</li>
            <li>Fast Sampling</li>
          </ul>
        </div>
      </section>
    {% endcomment %}

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Customization Services</span>
    </nav>

    <h1 class="oem-page-heading">OEM &amp; ODM Custom Sportswear Manufacturing</h1>

