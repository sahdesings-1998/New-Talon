    }

    .oem-craft-section .oem-craft-card__text { font-size: 0.75rem; }

    .oem-process-item h3 { font-size: clamp(13px, 4.5vw, 17px); margin-bottom: 8px !important; }
    .oem-process-item p  { font-size: 14px; line-height: 21px; word-spacing: 0; }

    .oem-media-card__body h3 { font-size: clamp(13px, 4.5vw, 17px); padding-top: 16px; }
    .oem-media-card__body p  { font-size: clamp(12px, 3.5vw, 14px); line-height: 21px; word-spacing: 0; }

    .oem-lead-card__title { font-size: 14px; letter-spacing: 0; line-height: 1.2; }
    .oem-lead-card__sub   { font-size: 14px; letter-spacing: 0; line-height: 1.2; }

    .oem-hero { min-height: 320px; }
    .oem-hero__content { padding: 1.1rem; }
    .oem-hero__content h1 { font-size: clamp(1.4rem, 7vw, 1.85rem); }

    .talon-stats-bar { flex-direction: column; gap: 0; }
    .talon-stat-divider { width: 100%; height: 1px; align-self: auto; }
    .talon-stat-item  { flex: none; width: 100%; padding: 0.85rem 1rem; }
    .talon-stat-sub   { max-width: none; font-size: 14px; line-height: 27px; word-spacing: 0; }

    .talon-faq-heading { font-size: clamp(15px, 5vw, 20px) !important; letter-spacing: 0; line-height: 1.2; }

    {% comment %} .shopify-section--talon-oem-faq .talon-faq-section {
      padding-top: 22px !important;
      padding-bottom: 22px !important;
    } {% endcomment %}

    .shopify-section--talon-oem-faq .talon-faq-heading {
      margin: 20px 0 !important;
      font-size: clamp(15px, 5vw, 20px) !important;
      letter-spacing: 0;
      line-height: 1.2;
    }

    .talon-faq-list summary {
      font-size: 14px;
      word-spacing: 0;
    }

    .talon-faq-list details p,
    .talon-faq-list details .oem-faq-answer p {
      font-size: 12px;
      line-height: 16px !important;
      word-spacing: -0.1px !important;
    }

    .talon-logistics-inner .talon-content-box h3 {
      font-size: clamp(13px, 4.5vw, 17px);
      margin-bottom: 8px !important;
    }

    .talon-logistics-inner .talon-content-box p,
    .talon-logistics-inner .talon-richtext {
      font-size: 14px !important;
      line-height: 21px;
      word-spacing: 0;
    }

    .talon-logistics-inner .talon-richtext--bulk ol li { font-size: 13px; }

    .oem-workflow-card__title { font-size: 12px; letter-spacing: 0; line-height: 16px; }

    .oem-timeline__title { font-size: 13px; }
    .oem-timeline__text  { font-size: 11px; }

    .oem-rfq-panel__content h3 { font-size: 0.9rem; }

    .oem-downloads { grid-template-columns: 1fr; }
    .oem-why       { padding: 0.85rem; }

    body:has(.oem-page) .footer .footer__inner { padding-inline: 1rem; }

    .breadcrumb {
      gap: 0.25rem;
      font-size: 0.8rem;
      padding-top: 22px !important;
      margin-bottom: 13px;
    }

    .breadcrumb a,
    .breadcrumb-current {
      white-space: normal;
    }
  }

  /* ════════════════════════════════════════════════════════
     PRINT
  ════════════════════════════════════════════════════════ */
  @media print {
    .oem-hero,
    .oem-rfq,
    .oem-craft-section .oem-craft-card__img {
      break-inside: avoid;
    }

    .oem-hero__image { display: none; }
    .oem-hero__content { color: #000; }
  }
</style>

<div class="oem-page">
  <div class="oem-wrap">
    {%- liquid
      assign oem_show_supplementary_sections = false
      assign oem_show_downloads = false
    -%}

    {%- liquid
      assign oem_hero_image = 'custom-sportswear-manufacturing-factory-banner.jpg'
      assign oem_hero_alt = 'Custom sportswear manufacturing factory for OEM ODM and private label solutions'
      assign oem_hero_sizes = '(min-width: 769px) min(1320px, 100vw), 100vw'
    -%}

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Customization Services</span>
    </nav>

    <h1 class="oem-page-heading">OEM &amp; ODM Custom Sportswear Manufacturing</h1>

    <div class="oem-zone--customization">
      <section
        class="oem-section oem-section-Custom-Service"
        id="customization-capabilities"
        aria-labelledby="customization-capabilities-title"
      >
        <h2 class="oem-section-title oem-section-title-Cs" id="customization-capabilities-title">Customization Services</h2>
      </section>

      <section
        class="oem-section oem-customization-major"
        id="production-process"
        aria-labelledby="oem-process-title"
      >
        <div class="oem-process-panel">
          <header class="oem-process__header">
            <h2 class="oem-lead-card__title" id="oem-process-title">ONE-STOP SPORTSWEAR CUSTOMIZATION SOLUTION</h2>
            <p class="oem-lead-card__sub">SPORTSWEAR MANUFACTURER WITH 20 YEARS OF EXPERIENCE</p>
          </header>
          {%- render 'talon-oem-process-grid' -%}
        </div>
      </section>

      <section
        class="oem-section oem-customization-major"
        id="manufacturing-workflow"
        aria-labelledby="oem-workflow-detail-title"
      >
        <h2 class="oem-section-title" id="oem-workflow-detail-title">OEM / ODM MANUFACTURING WORKFLOW</h2>
        {%- render 'talon-factory-workflow-2026' -%}
      </section>

      {%- render 'talon-oem-customization-capability-grid' -%}
    </div>

    {%- render 'talon-craft-materials-showcase' -%}

    {%- if oem_show_supplementary_sections -%}
      <section class="oem-section" id="why-work-talon">
        <h2 class="oem-section-title">Why Work With Talon</h2>
        <div class="oem-trust">
          <p class="oem-trust__intro">
            Built for serious custom apparel projects, Talon combines factory execution, quality control, and
            export-ready operations to deliver reliable OEM and ODM outcomes.
          </p>
          <div class="oem-trust-grid">
            <article class="oem-trust-card">
              <div class="oem-trust-card__top">
                <h3>OEM Manufacturing</h3>
                <span class="oem-trust-tag">Factory Direct</span>
              </div>
              <p>Production workflows aligned to your specs, from approved sample to stable bulk output.</p>
            </article>
            <article class="oem-trust-card">
              <div class="oem-trust-card__top">
                <h3>ODM / Private Label</h3>
                <span class="oem-trust-tag">Brand Ready</span>
              </div>
              <p>Fast product adaptation with private label execution, trims, and packaging for market launch.</p>
            </article>
            <article class="oem-trust-card">
              <div class="oem-trust-card__top">
                <h3>Bulk Orders</h3>
                <span class="oem-trust-tag">Volume Support</span>
              </div>
              <p>Capacity-based planning for seasonal, repeat, and large-volume sportswear requirements.</p>
            </article>
            <article class="oem-trust-card">
              <div class="oem-trust-card__top">
                <h3>Sampling Service</h3>
                <span class="oem-trust-tag">Fast Sampling</span>
              </div>
              <p>Structured sample development for fit, fabric, print, and branding approvals before production.</p>
            </article>
            <article class="oem-trust-card">
              <div class="oem-trust-card__top">
                <h3>Worldwide Shipping</h3>
                <span class="oem-trust-tag">Global Delivery</span>
              </div>
              <p>Export-ready dispatch with documentation and packaging suited for international B2B supply.</p>
            </article>
            <article class="oem-trust-card">
              <div class="oem-trust-card__top">
                <h3>Factory Production</h3>
                <span class="oem-trust-tag">Quality Control</span>
              </div>
              <p>In-line QC checkpoints and finishing controls to maintain consistency across every batch.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="oem-section" id="oem-service-details-legacy">
        <h2 class="oem-section-title">OEM / ODM Service Details</h2>
        {%- assign oem_detail_img_sizes = '(min-width: 769px) min(720px, 55vw), 100vw' -%}
        <div class="oem-details-grid">
          <article class="oem-card oem-detail-card">
            <div class="oem-detail-card__media">
              {%- render 'talon-oem-asset-image', asset: 'talon-hd-woven-labels-detail.png', alt: 'TALON Woven Labels Detail', sizes: oem_detail_img_sizes, preset: 'large', width: 1536, height: 1024, loading: 'lazy' -%}
            </div>
            <div class="oem-detail-card__body">
              <h3>Woven Labels</h3>
              <p>Custom woven neck and side labels engineered to reinforce brand identity across every production batch.</p>
            </div>
          </article>
          <article class="oem-card oem-detail-card">
            <div class="oem-detail-card__media">
              {%- render 'talon-oem-asset-image', asset: 'talon-hd-hang-tags-flatlay.png', alt: 'TALON Premium Hang Tags', sizes: oem_detail_img_sizes, preset: 'large', width: 1536, height: 1024, loading: 'lazy' -%}
            </div>
            <div class="oem-detail-card__body">
              <h3>Hang Tags</h3>
              <p>Brand-specific hang tags with SKU and care details for clean retail presentation and inventory clarity.</p>
            </div>
          </article>
          <article class="oem-card oem-detail-card">
            <div class="oem-detail-card__media">
              {%- render 'talon-oem-asset-image', asset: 'talon-hd-neck-label-detail.png', alt: 'TALON Neck Label Detail', sizes: oem_detail_img_sizes, preset: 'large', width: 1536, height: 1024, loading: 'lazy' -%}
            </div>
            <div class="oem-detail-card__body">
              <h3>Neck Labels</h3>
              <p>Printed and woven neck label options matched to fabric type, wash standards, and brand guidelines.</p>
            </div>
          </article>
          <article class="oem-card oem-detail-card">
            <div class="oem-detail-card__media">
              {%- render 'talon-oem-asset-image', asset: 'talon-hd-premium-custom-packaging.png', alt: 'TALON Custom Packaging', sizes: oem_detail_img_sizes, preset: 'large', width: 1536, height: 1024, loading: 'lazy' -%}
            </div>
            <div class="oem-detail-card__body">
              <h3>Custom Packaging</h3>
              <p>Polybags, boxes, and carton labeling configured for efficient export handling and premium brand delivery.</p>
            </div>
          </article>
          <article class="oem-card oem-detail-card">
            <div class="oem-detail-card__media">
              {%- render 'talon-oem-asset-image', asset: 'talon-hd-performance-zipper-detail.png', alt: 'TALON Performance Zipper Detail', sizes: oem_detail_img_sizes, preset: 'large', width: 1536, height: 1024, loading: 'lazy' -%}
            </div>
            <div class="oem-detail-card__body">
              <h3>Zippers</h3>
              <p>Durable zipper components and custom pullers selected for performance use and long-term wear reliability.</p>
            </div>
          </article>
          <article class="oem-card oem-detail-card">
            <div class="oem-detail-card__media">
              {%- render 'talon-oem-asset-image', asset: 'talon-hd-sports-accessories-lifestyle.png', alt: 'TALON Sports Accessories Lifestyle', sizes: oem_detail_img_sizes, preset: 'large', width: 1536, height: 1024, loading: 'lazy' -%}
            </div>
            <div class="oem-detail-card__body">
              <h3>Accessories</h3>
              <p>Integrated accessory support including drawcords, trims, badges, and branding components for full OEM setup.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="oem-section" id="why-choose-talon">
        <div class="oem-why">
          <h2 class="oem-section-title">Why Choose Talon</h2>
          <p class="oem-why__intro">
            Talon is built for serious B2B custom apparel programs with factory-led production, structured QC, and
            dependable delivery execution.
          </p>
          <div class="oem-why__metrics">
            <div class="oem-why__metric"><strong>10+ Years</strong><span>OEM Experience</span></div>
            <div class="oem-why__metric"><strong>1000+</strong><span>Bulk Orders</span></div>
            <div class="oem-why__metric"><strong>Global</strong><span>Shipping Support</span></div>
            <div class="oem-why__metric"><strong>Fast</strong><span>Turnaround Flow</span></div>
          </div>
          <div class="oem-why__grid">
            <article class="oem-why__item">
              <span class="oem-why__icon">01</span>
              <h3>Premium Quality</h3>
              <p>Process-level quality control from raw material checks to final packing.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">02</span>
              <h3>Factory Direct Production</h3>
              <p>Direct manufacturing coordination for consistent specs and stable output.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">03</span>
              <h3>Low MOQ</h3>
              <p>Flexible order minimums designed for brand growth and pilot runs.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">04</span>
              <h3>Fast Sampling</h3>
              <p>Quick sample development to reduce approval cycles and launch delays.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">05</span>
              <h3>Worldwide Shipping</h3>
              <p>Export-ready logistics handling for distributors and international buyers.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">06</span>
              <h3>Quality Control</h3>
              <p>In-line production audits and final inspections before shipment release.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">07</span>
              <h3>Bulk Manufacturing Support</h3>
              <p>Capacity planning and batch scheduling for repeat and high-volume orders.</p>
            </article>
            <article class="oem-why__item">
              <span class="oem-why__icon">08</span>
              <h3>Private Label Expertise</h3>
              <p>Integrated brand execution across labels, trims, packaging, and finishing.</p>
            </article>
          </div>
        </div>
      </section>
    {%- endif -%}

    <section class="oem-process-section oem-section">
      <div class="page-width">
        <div class="oem-process-grid">
          <div class="oem-process-item">
            <h3>Our Requirements</h3>
            <p>
              We can customize any sportswear, you just need to send us your design file, or tell us your ideas, we can
              customize for you. After receiving your request, we will reply to your request in time and get all the
              details from you. Make sure the quality of the sportswear is what you expect.
            </p>
          </div>
          <div class="oem-process-item">
            <h3>Sample Production</h3>
            <p>
              After confirming all the details of the sportswear, we will start to produce samples, the production time
              of the samples is about 10–20 days. After the samples are completed, we will take pictures for you to
              confirm and then send them to you via DHL/UPS express. Please contact us if you need to modify the sample
              after receiving it.
            </p>
          </div>
          <div class="oem-process-item">
            <h3>Mass Production</h3>
            <p>
              When it is confirmed that the sample clothes are exactly as you expect, we will make sportswear in batches
              through a powerful production line. In addition, we will keep you updated with the production progress.
              Make sure every step is what you expected.
            </p>
          </div>
          <div class="oem-process-item">
            <h3>Quality Inspection</h3>
            <p>
              To be able to ensure that all sportswear are of the expected quality, our strict and experienced quality
              inspection team has carried out many strict inspections and supervision in the selection of raw materials,
              incoming fabrics, craftsmanship, stitching, ironing and packaging.
            </p>
          </div>
          <div class="oem-process-item">
            <h3>Timely Delivery</h3>
            <p>
              Our production efficiency will be fully completed before the shipping date. And timely delivery after
              receiving the balance payment.
            </p>
          </div>
          <div class="oem-process-item">
            <h3>After-sales Service</h3>
            <p>
              We promise that after the goods are dispatched, we will still keep in touch with you. We will solve all
              problems encountered.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="oem-page talon-logistics-payment" id="oem-rfq">
      <div class="talon-logistics-wrap oem-logistics">
        <div class="talon-logistics-inner">

          <div class="oem-section oem-section-logistics">
            <h2 class="oem-section-title">
              {{ section.settings.logistics_heading | default: 'Logistics Service' }}
            </h2>
            {%- if section.settings.logistics_brands_image != blank and section.settings.logistics_image != blank -%}
              <div class="talon-logistics-wrapper talon-logistics-wrapper--dual">
                <div class="talon-logistics-media talon-logistics-media--column">
                  <img
                    src="{{ section.settings.logistics_image | image_url: width: 1200 }}"
                    alt="Global logistics — air freight, sea freight, and road transport"
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  >
                </div>
                <div class="talon-logistics-media talon-logistics-media--column">
                  <img
                    src="{{ section.settings.logistics_brands_image | image_url: width: 800 }}"
                    alt="DHL, FedEx, UPS, TNT, and EMS shipping partners"
                    width="800"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  >
                </div>
              </div>
            {%- else -%}
              <div class="talon-logistics-media">
                {% if section.settings.logistics_image != blank %}
                  <img
                    src="{{ section.settings.logistics_image | image_url: width: 1200 }}"
                    alt="Global logistics — air freight, sea freight, and road transport"
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  >
                {% else %}
                  <img
                    src="{{ 'global-logistics-and-transportation.jpg' | asset_url }}"
                    alt="Global logistics — air freight, sea freight, and road transport"
                    width="1200"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  >
                {% endif %}
              </div>
            {%- endif -%}
          </div>

          <div class="oem-section oem-section-payment">
            <h2 class="oem-section-title">
              {{ section.settings.payment_heading | default: 'Payment Method' }}
            </h2>
            <div class="talon-payment-box">
              {% if section.settings.payment_image != blank %}
                <img
                  src="{{ section.settings.payment_image | image_url: width: 1200 }}"
                  alt="Payment Options"
                  loading="lazy"
                >
              {% else %}
                <img
                  src="https://cdn.shopify.com/s/files/1/0631/4472/2477/files/Payment-options.png?v=1779705017"
                  alt="Payment Options"
                  loading="lazy"
                >
              {% endif %}
            </div>
          </div>

          <div class="talon-content-box talon-content-box-sample-order" style="padding-top: 24px !important;">
            <h3>{{ section.settings.sample_title | default: 'Sample Order' }}</h3>
            <p>{{ section.settings.sample_text }}</p>
          </div>

          <div class="talon-content-box talon-content-box--bulk">
            <h3>{{ section.settings.bulk_title | default: 'Bulk order' }}</h3>
            <div class="talon-richtext oem-richtext talon-richtext--bulk">
              {%- liquid
                assign bulk_html = section.settings.bulk_text
                if bulk_html contains '<ul>'
                  assign bulk_html = bulk_html | replace: '<ul>', '<ol>' | replace: '</ul>', '</ol>'
                endif
              -%}
              {{ bulk_html }}
            </div>
          </div>

          <div class="talon-content-box">
            <h3>{{ section.settings.shipping_title | default: 'Changes of Shipping' }}</h3>
            <p>{{ section.settings.shipping_text }}</p>
          </div>

        </div>
      </div>
    </section>

    {%- if oem_show_downloads -%}
      <section class="oem-section" id="downloads">
        <h2 class="oem-section-title">Downloads</h2>
        <p class="oem-downloads__intro">
          Access updated OEM/ODM resources for product planning, sizing alignment, and custom manufacturing execution.
        </p>
        <div class="oem-downloads">
          <article class="oem-download-card">
            <div class="oem-download-card__meta">
              <span class="oem-icon oem-download-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 4h11a1.5 1.5 0 0 1 1.5 1.5V19a1.5 1.5 0 0 1-1.5 1.5H5"/><path d="M5 4v16.5"/><path d="M9 9h7M9 12.5h7M9 16h5"/><path d="M16.5 14.5h3v3.5h-3z"/><path d="M17.25 15.25a1.25 1.25 0 0 0 0 1.75"/>
                </svg>
              </span>
              <h3>Product Catalog</h3>
            </div>
            <p>Download our OEM sportswear catalog featuring jerseys, gymwear, and teamwear manufacturing options.</p>
            <a class="button oem-btn oem-btn--primary" href="/files/Talon-OEM-ODM-Catalog.pdf" target="_blank" rel="noopener">Download Catalog</a>
          </article>
          <article class="oem-download-card">
            <div class="oem-download-card__meta">
              <span class="oem-icon oem-download-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="5.5" r="2"/><path d="M12 7.5V10"/><path d="M8.5 10.5h7"/><path d="M9.5 10.5V17M14.5 10.5V17"/><path d="M7.5 17.5h9"/><path d="M5.5 12.5h2M16.5 12.5h2"/><path d="M4.5 8.5h15"/>
                </svg>
              </span>
              <h3>Size Chart</h3>
            </div>
            <p>Use our sizing reference to align fit standards before sampling and bulk production approvals.</p>
            <a class="button oem-btn oem-btn--primary" href="/files/Talon-Size-Chart.pdf" target="_blank" rel="noopener">View Size Guide</a>
          </article>
          <article class="oem-download-card">
            <div class="oem-download-card__meta">
              <span class="oem-icon oem-download-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 3h11l3 3v14H6z"/><path d="M17 3v3h3"/><path d="M9 9h6M9 12h6M9 15h4"/><path d="M3 20h3"/><path d="M18 20h3"/><path d="M8 20V17.5h8V20"/><path d="M10 17.5V15h4v2.5"/>
                </svg>
              </span>
              <h3>OEM Guide</h3>
            </div>
            <p>Review the Talon OEM workflow, production checkpoints, and private label requirements.</p>
            <a class="button oem-btn oem-btn--primary" href="/files/Talon-OEM-Guide.pdf" target="_blank" rel="noopener">Download OEM Guide</a>
          </article>
        </div>
      </section>
    {%- endif -%}

  </div>

  {%- if settings.oem_turnstile_site_key != blank -%}
    <script src="{{ 'oem-rfq-turnstile.js' | asset_url }}" defer></script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Talon OEM page",
  "class": "shopify-section--talon-oem-main",
  "settings": [
    {
      "type": "text",
      "id": "logistics_heading",
      "label": "Logistics heading",
      "default": "Logistics Service"
    },
    {
      "type": "image_picker",
      "id": "logistics_image",
      "label": "Logistics image (transport / cargo)"
    },
    {
      "type": "image_picker",
      "id": "logistics_brands_image",
      "label": "Logistics image (DHL / FedEx / courier logos)"
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Payment heading",
      "default": "Payment Method"
    },
    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "Payment image"
    },
    {
      "type": "text",
      "id": "sample_title",
      "label": "Sample order title",
      "default": "Sample Order"
    },
    {
      "type": "textarea",
      "id": "sample_text",
      "label": "Sample order text",
      "default": "For the samples, we usually send it directly to you by DHL/UPS/Fedex express, and the transportation time is 5-7 days"
    },
    {
      "type": "text",
      "id": "bulk_title",
      "label": "Bulk order title",
      "default": "Bulk order"
    },
    {
      "type": "richtext",
      "id": "bulk_text",
      "label": "Bulk order text",
      "default": "<p>For bulk order, We have 4 different kinds of logistics options:</p><ol><li>DHL / UPS / FedEx Express (5–7 days)</li><li>Air Freight via Freight Forwarder (12–15 days, all taxes included)</li><li>Truck + Air Freight via Freight Forwarder (30–35 days to EU, all taxes included)</li><li>Sea Freight via Freight Forwarder (45–60 days to EU, all taxes included)</li></ol>"
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping changes title",
      "default": "Changes of Shipping"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping changes text",
      "default": "Any changes that you make regarding shipping once the item is shipped, including but not limited to changing the address, putting an order on hold, or updating shipping settings/preferences may delay your receipt of the products and replacement products and/or refunds. If you have any modification, you must do so prior to your order being shipped."
    }
  ],
  "presets": [
    {
      "name": "Talon OEM page"
    }
  ]
}
{% endschema %}
