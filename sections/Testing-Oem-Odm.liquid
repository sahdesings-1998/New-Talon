      line-height: 21px;
      word-spacing: 0;
    }

    .shopify-section--talon-oem-main .talon-logistics-inner .talon-richtext--bulk ol {
      padding-left: 1.25rem !important;
    }

    .talon-divider { margin: clamp(2rem, 4vw, 3rem) 0; }

    .talon-stats-bar { flex-wrap: wrap; }
    .talon-stat-item { flex: 1 1 45%; min-width: 0; padding: 0.75rem 0.65rem; }
    .talon-stat-title {
      font-size: clamp(15px, 3.5vw, 19px);
      letter-spacing: 0;
      line-height: 21px;
    }
    .talon-stat-sub { font-size: 16px; line-height: 16px; }

    .oem-craft-section .oem-craft-card__title { font-size: 13px; }
    .oem-craft-section__desc { font-size: 16px; line-height: 22px; word-spacing: 0; }
