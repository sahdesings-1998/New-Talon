    .oem-form-grid    { grid-template-columns: 1fr; }
    .oem-trust-grid   { grid-template-columns: 1fr; }
    .oem-details-grid { grid-template-columns: 1fr; }
    .oem-downloads    { grid-template-columns: 1fr; }
    .oem-rfq          { grid-template-columns: 1fr; }
    .oem-why          { padding: 0.95rem; }
    .oem-why__metrics,
    .oem-why__grid    { grid-template-columns: 1fr; }

    .talon-faq-heading { font-size: 20px; line-height: 1.3; }
    .talon-faq-list summary { font-size: 15px; padding-left: 1.5rem; }
    .talon-faq-list details p,
    .talon-faq-list details .oem-faq-answer p { font-size: 14px; line-height: 1.65 !important; }
    .oem-faq summary { font-size: 0.85rem; }
    .oem-faq details p,
    .oem-faq details .oem-faq-answer p { font-size: 15px; line-height: 1.65 !important; }

    .talon-logistics-wrapper--dual { flex-direction: column; }
    .talon-logistics-wrapper--dual .talon-logistics-media--column {
      flex: 0 0 auto;
      width: 100%;
      aspect-ratio: 16 / 10;
    }

    .talon-logistics-inner .talon-content-box h3 {
      font-size: clamp(0.95rem, 3.5vw, 1rem);
      letter-spacing: 0;
    }

    .talon-logistics-inner .talon-content-box p,
    .talon-logistics-inner .talon-richtext {
      font-size: 14px;
      line-height: 27px;
      word-spacing: 0;
    }

    .talon-logistics-inner .talon-richtext--bulk ol li {
