{% schema %}
{
  "name": "TALON Mosaic Gallery",
  "tag": "section",
  "class": "shopify-section--talon-mosaic-gallery",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Top Button / Tag"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Top Button / Tag",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button / Tag Text",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link (Optional)"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ff6600"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "#e65c00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button Rounded Corners",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "text",
      "id": "container_max_width",
      "label": "Container Max Width",
      "default": "1440px"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 6,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Desktop Gap Between Cards",
      "default": 18
    },
    {
      "type": "range",
      "id": "grid_gap_tablet",
      "min": 6,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Tablet Gap",
      "default": 14
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Desktop Card Corner Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_border_radius_tablet",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Tablet Card Corner Radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_border_radius_mobile",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Mobile Card Corner Radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Stagger Offsets"
    },
    {
      "type": "range",
      "id": "stagger_offset_1",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Column 1 Top Offset",
      "default": 80
    },
    {
      "type": "range",
      "id": "stagger_offset_2",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Column 2 Top Offset",
      "default": 20
    },
    {
      "type": "range",
      "id": "stagger_offset_4",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Column 4 Top Offset",
      "default": 90
    },
    {
      "type": "header",
      "content": "Colors & Section Spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card Placeholder Background",
      "default": "#f4f5f7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 32
    },
    {
      "type": "header",
      "content": "Column 1 (Left Card)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Card 1 Image"
    },
    {
      "type": "text",
      "id": "image_alt_1",
      "label": "Card 1 Alt Text"
    },
    {
      "type": "url",
      "id": "link_1",
