                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Image 4</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Col 3 - Bottom Card {%- endcomment -%}
        {%- if link_5 != blank -%}
          <a href="{{ link_5 }}" class="talon-mg__card talon-mg__card--col3-bottom" {% if new_tab_5 %}target="_blank" rel="noopener"{% endif %} aria-label="{{ alt_5 }}">
            {%- if img_5 != blank -%}
