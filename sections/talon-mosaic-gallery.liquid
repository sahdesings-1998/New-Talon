{{ 'talon-mosaic-gallery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading_strategy = 'lazy'
  if section.index <= 2
    assign loading_strategy = 'eager'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --talon-mg-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --talon-mg-text: {{ section.settings.text_color | default: '#111827' }};
    --talon-mg-card-bg: {{ section.settings.card_background_color | default: '#f4f5f7' }};
    --talon-mg-max-w: {{ section.settings.container_max_width | default: '1440px' }};
    --talon-mg-pt: {{ section.settings.padding_top | default: 48 }}px;
    --talon-mg-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    --talon-mg-pt-mob: {{ section.settings.padding_top_mobile | default: 32 }}px;
    --talon-mg-pb-mob: {{ section.settings.padding_bottom_mobile | default: 32 }}px;
    --talon-mg-gap: {{ section.settings.grid_gap | default: 18 }}px;
    --talon-mg-gap-tab: {{ section.settings.grid_gap_tablet | default: 14 }}px;
    --talon-mg-gap-mob: {{ section.settings.grid_gap_mobile | default: 10 }}px;
    --talon-mg-radius: {{ section.settings.card_border_radius | default: 12 }}px;
    --talon-mg-radius-tab: {{ section.settings.card_border_radius_tablet | default: 10 }}px;
    --talon-mg-radius-mob: {{ section.settings.card_border_radius_mobile | default: 8 }}px;
    --talon-mg-btn-bg: {{ section.settings.button_bg_color | default: '#ff6600' }};
    --talon-mg-btn-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --talon-mg-btn-hover-bg: {{ section.settings.button_hover_bg_color | default: '#e65c00' }};
    --talon-mg-btn-radius: {{ section.settings.button_border_radius | default: 4 }}px;
    --talon-mg-offset-1: {{ section.settings.stagger_offset_1 | default: 80 }}px;
    --talon-mg-offset-2: {{ section.settings.stagger_offset_2 | default: 20 }}px;
    --talon-mg-offset-4: {{ section.settings.stagger_offset_4 | default: 90 }}px;
  }
</style>

<div id="talon-mg-{{ section.id }}" class="talon-mg talon-mosaic-gallery-section" data-section-id="{{ section.id }}">
  <div class="talon-mg__container">
    
    {%- comment -%} Optional Header / Tag Button (e.g. 'Explore') {%- endcomment -%}
    {%- if section.settings.show_button and section.settings.button_text != blank -%}
      <div class="talon-mg__header">
        {%- if section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="talon-mg__tag-btn">
            {{ section.settings.button_text | escape }}
          </a>
        {%- else -%}
          <span class="talon-mg__tag-btn">
            {{ section.settings.button_text | escape }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 4-Column Staggered Mosaic Layout (1-2-2-1 Cards) {%- endcomment -%}
    <div class="talon-mg__grid">

      {%- comment -%} ==========================================
          COLUMN 1: Single Tall/Portrait Card (Offset Down)
          ========================================== {%- endcomment -%}
      <div class="talon-mg__col talon-mg__col--1">
        {%- liquid
          assign img_1 = section.settings.image_1
          assign alt_1 = section.settings.image_alt_1 | default: 'Mosaic Item 1' | escape
          assign link_1 = section.settings.link_1
          assign new_tab_1 = section.settings.open_in_new_tab_1
        -%}
        {%- if link_1 != blank -%}
          <a href="{{ link_1 }}" class="talon-mg__card talon-mg__card--col1" {% if new_tab_1 %}target="_blank" rel="noopener"{% endif %} aria-label="{{ alt_1 }}">
            {%- if img_1 != blank -%}
              {{ img_1 | image_url: width: 1200 | image_tag: class: 'talon-mg__image', alt: alt_1, loading: loading_strategy, widths: '400, 600, 800, 1200' }}
            {%- else -%}
              <div class="talon-mg__placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Image 1</span>
              </div>
            {%- endif -%}
          </a>
        {%- else -%}
          <div class="talon-mg__card talon-mg__card--col1">
            {%- if img_1 != blank -%}
              {{ img_1 | image_url: width: 1200 | image_tag: class: 'talon-mg__image', alt: alt_1, loading: loading_strategy, widths: '400, 600, 800, 1200' }}
            {%- else -%}
              <div class="talon-mg__placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Image 1</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ==========================================
          COLUMN 2: 2 Stacked Cards (Top & Bottom)
          ========================================== {%- endcomment -%}
      <div class="talon-mg__col talon-mg__col--2">
        {%- liquid
