                <span>Image 3</span>
              </div>
            {%- endif -%}
          </a>
        {%- else -%}
          <div class="talon-mg__card talon-mg__card--col2-bottom">
            {%- if img_3 != blank -%}
              {{ img_3 | image_url: width: 1200 | image_tag: class: 'talon-mg__image', alt: alt_3, loading: loading_strategy, widths: '400, 600, 800, 1200' }}
            {%- else -%}
              <div class="talon-mg__placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                <span>Image 3</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ==========================================
          COLUMN 3: 2 Stacked Cards (Starts at Top)
