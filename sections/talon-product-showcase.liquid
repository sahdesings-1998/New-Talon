{{ 'talon-product-showcase.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5
  assign loading_strategy = 'lazy'
  if section.index <= 2
    assign loading_strategy = 'eager'
  endif

  # Filter blocks by type
  assign gallery_blocks = section.blocks | where: 'type', 'gallery_image'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign button_blocks = section.blocks | where: 'type', 'button'
  assign badge_blocks = section.blocks | where: 'type', 'badge'

  # Fallback default assets for images
  assign default_img_1 = 'talon-jacket-gallery-1.jpg' | asset_url
  assign default_img_2 = 'talon-jacket-gallery-2.jpg' | asset_url
  assign default_img_3 = 'talon-jacket-gallery-3.jpg' | asset_url
  assign default_img_4 = 'talon-jacket-gallery-4.jpg' | asset_url
  assign default_img_5 = 'talon-jacket-gallery-5.jpg' | asset_url
-%}

<style>
  #shopify-section-{{ section.id }} {
    --talon-ps-max-w: {{ section.settings.container_max_width | default: '1440px' }};
    --talon-ps-pt: {{ section.settings.padding_top }}px;
    --talon-ps-pb: {{ section.settings.padding_bottom }}px;
    --talon-ps-pt-mob: {{ section.settings.padding_top_mobile }}px;
    --talon-ps-pb-mob: {{ section.settings.padding_bottom_mobile }}px;
    --talon-ps-radius: {{ section.settings.image_border_radius }}px;
    --talon-ps-gallery-gap: {{ section.settings.gallery_gap }}px;
    --talon-ps-heading-color: {{ section.settings.heading_color }};
    --talon-ps-text-color: {{ section.settings.text_color }};
    --talon-ps-muted-text: {{ section.settings.muted_text_color }};
    --talon-ps-eyebrow-color: {{ section.settings.eyebrow_color }};
    --talon-ps-card-bg: {{ section.settings.card_background }};
    --talon-ps-card-border: {{ section.settings.card_border }};
    --talon-ps-accent: {{ section.settings.accent_color }};
    --talon-ps-btn-bg: {{ section.settings.button_bg_color }};
    --talon-ps-btn-text: {{ section.settings.button_text_color }};
    --talon-ps-btn-hover-bg: {{ section.settings.button_hover_bg_color }};

    {% case section.settings.gallery_aspect_ratio %}
      {% when 'portrait' %}
        --talon-ps-main-aspect: 3 / 4;
        --talon-ps-thumb-aspect: 3 / 4;
        --talon-ps-mobile-main-aspect: 3 / 4;
      {% when 'square' %}
        --talon-ps-main-aspect: 1 / 1;
        --talon-ps-thumb-aspect: 1 / 1;
        --talon-ps-mobile-main-aspect: 1 / 1;
      {% when 'natural' %}
        --talon-ps-main-aspect: auto;
        --talon-ps-thumb-aspect: auto;
        --talon-ps-mobile-main-aspect: auto;
      {% else %}
        --talon-ps-main-aspect: 3 / 4;
        --talon-ps-thumb-aspect: 3 / 4;
        --talon-ps-mobile-main-aspect: 3 / 4;
    {% endcase %}
  }

  #shopify-section-{{ section.id }} .talon-product-showcase {
    padding-top: var(--talon-ps-pt-mob);
    padding-bottom: var(--talon-ps-pb-mob);
    {% if section.settings.use_custom_bg %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .talon-product-showcase {
      padding-top: var(--talon-ps-pt);
      padding-bottom: var(--talon-ps-pb);
    }
  }
</style>

<div class="talon-product-showcase {% if section.settings.color_scheme != blank and section.settings.use_custom_bg == false %}color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}{% endif %} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}" id="TalonShowcase-{{ section.id }}">
  <div class="talon-product-showcase__container">
    <div class="talon-product-showcase__inner talon-product-showcase__inner--split-{{ section.settings.desktop_split }} {% if section.settings.desktop_layout == 'gallery_right' %}talon-product-showcase__inner--reversed{% endif %}">
      
      {%- comment -%} ==========================================
          LEFT COLUMN: Carousel Gallery with 5-Thumbnail Strip
          ========================================== {%- endcomment -%}
      <div class="talon-product-showcase__gallery-col" data-gallery-container>
        <div class="talon-product-showcase__gallery-wrapper">

          {%- liquid
            assign img_list = ''
            assign alt_list = ''

            # Check if any gallery block has an image uploaded
            assign has_block_images = false
            for block in gallery_blocks
              if block.settings.image != blank
                assign has_block_images = true
                break
              endif
            endfor

            # Check if section settings have images uploaded
            assign has_section_images = false
            if section.settings.image_main != blank or section.settings.image_1 != blank or section.settings.image_2 != blank or section.settings.image_3 != blank or section.settings.image_4 != blank
              assign has_section_images = true
            endif

            if has_block_images
              for block in gallery_blocks limit: 5
                assign cur_src = ''
                if block.settings.image != blank
                  assign cur_src = block.settings.image | image_url: width: 1200
                  assign cur_alt = block.settings.image.alt | default: block.settings.image_alt | default: section.settings.heading | escape
                else
                  case forloop.index
                    when 1
                      if section.settings.image_main != blank
                        assign cur_src = section.settings.image_main | image_url: width: 1200
                      else
                        assign cur_src = default_img_1
                      endif
                    when 2
                      if section.settings.image_1 != blank
                        assign cur_src = section.settings.image_1 | image_url: width: 1200
                      else
                        assign cur_src = default_img_2
                      endif
                    when 3
                      if section.settings.image_2 != blank
                        assign cur_src = section.settings.image_2 | image_url: width: 1200
                      else
                        assign cur_src = default_img_3
                      endif
                    when 4
                      if section.settings.image_3 != blank
                        assign cur_src = section.settings.image_3 | image_url: width: 1200
                      else
                        assign cur_src = default_img_4
                      endif
                    when 5
                      if section.settings.image_4 != blank
                        assign cur_src = section.settings.image_4 | image_url: width: 1200
                      else
                        assign cur_src = default_img_5
                      endif
                  endcase
                  assign cur_alt = block.settings.image_alt | default: section.settings.heading | escape
                endif

                if forloop.first
                  assign img_list = cur_src
                  assign alt_list = cur_alt
                else
                  assign img_list = img_list | append: '|||' | append: cur_src
                  assign alt_list = alt_list | append: '|||' | append: cur_alt
                endif
              endfor
            elsif has_section_images
              assign src_1 = default_img_1
              if section.settings.image_main != blank
                assign src_1 = section.settings.image_main | image_url: width: 1200
              endif
              assign src_2 = default_img_2
              if section.settings.image_1 != blank
                assign src_2 = section.settings.image_1 | image_url: width: 1200
              endif
              assign src_3 = default_img_3
              if section.settings.image_2 != blank
                assign src_3 = section.settings.image_2 | image_url: width: 1200
              endif
              assign src_4 = default_img_4
              if section.settings.image_3 != blank
                assign src_4 = section.settings.image_3 | image_url: width: 1200
              endif
              assign src_5 = default_img_5
              if section.settings.image_4 != blank
                assign src_5 = section.settings.image_4 | image_url: width: 1200
              endif

              assign img_list = src_1 | append: '|||' | append: src_2 | append: '|||' | append: src_3 | append: '|||' | append: src_4 | append: '|||' | append: src_5
              assign alt_list = 'Primary Product View|||Product Back View|||Product Open View|||Product Front Angle View|||Product Hood & Collar Detail'
            else
              assign img_list = default_img_1 | append: '|||' | append: default_img_2 | append: '|||' | append: default_img_3 | append: '|||' | append: default_img_4 | append: '|||' | append: default_img_5
              assign alt_list = 'Primary Product View|||Product Back View|||Product Open View|||Product Front Angle View|||Product Hood & Collar Detail'
            endif

            assign all_imgs = img_list | split: '|||'
            assign all_alts = alt_list | split: '|||'
            assign total_count = all_imgs.size
          -%}

          <div class="talon-product-showcase__carousel-view" data-carousel-view>
            <!-- Large Main Featured Image Card -->
            <div class="talon-product-showcase__main-card" data-gallery-main>
              <div class="talon-product-showcase__media-box">
                <img src="{{ all_imgs[0] }}"
                     alt="{{ all_alts[0] }}"
                     class="talon-product-showcase__image"
                     data-main-display-image
                     loading="{{ loading_strategy }}"
                     width="800"
                     height="700">
              </div>

              {%- if total_count > 1 -%}
                <button type="button" class="talon-ps-nav talon-ps-nav--prev" data-nav-prev aria-label="Previous image">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>
                <button type="button" class="talon-ps-nav talon-ps-nav--next" data-nav-next aria-label="Next image">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
              {%- endif -%}

              <div class="talon-ps-counter-pill" data-gallery-counter>1/{{ total_count }}</div>

              {%- if section.settings.enable_lightbox -%}
                <button type="button" class="talon-product-showcase__zoom-btn" data-lightbox-trigger aria-label="Enlarge image">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                </button>
              {%- endif -%}
            </div>

            <!-- 5-Thumbnails Strip Directly Underneath -->
            <div class="talon-product-showcase__thumbs-strip" data-thumbs-strip>
              {%- for src in all_imgs -%}
                <div class="talon-product-showcase__thumb-item {% if forloop.first %}is-active{% endif %}"
                     data-thumb-index="{{ forloop.index0 }}"
                     data-full-src="{{ src }}"
                     data-alt="{{ all_alts[forloop.index0] }}"
                     {% if forloop.first %}aria-current="true"{% endif %}
                     tabindex="0"
                     role="button"
                     aria-label="Select view {{ forloop.index }}">
                  <img src="{{ src }}"
                       alt="{{ all_alts[forloop.index0] }}"
                       loading="lazy"
                       width="160"
                       height="160">
                </div>
              {%- endfor -%}
            </div>
          </div>

        </div>
      </div>

      {%- comment -%} ==========================================
          RIGHT COLUMN: Product Heading, Features, & Details
          ========================================== {%- endcomment -%}
      <div class="talon-product-showcase__info-col">
        <div class="talon-product-showcase__info-content">

          {%- comment -%} Optional Badges / Pills {%- endcomment -%}
          {%- if badge_blocks.size > 0 -%}
            <div class="talon-product-showcase__badges">
              {%- for block in badge_blocks -%}
                <span class="talon-product-showcase__badge talon-product-showcase__badge--{{ block.settings.style }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} Eyebrow / Subheading {%- endcomment -%}
          {%- if section.settings.subheading != blank -%}
            <div class="talon-product-showcase__eyebrow">
              <span class="talon-product-showcase__eyebrow-dot"></span>
              <span>{{ section.settings.subheading | escape }}</span>
            </div>
          {%- endif -%}

          {%- comment -%} Main Product Heading {%- endcomment -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="talon-product-showcase__heading talon-product-showcase__heading--{{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}

          {%- liquid
            assign wa_clean_phone = section.settings.whatsapp_phone | default: '8615976011860' | remove: ' ' | remove: '+' | remove: '-'
            assign wa_default_msg = 'Hello TALON! I would like to request a custom quote for the ' | append: section.settings.heading | strip
            assign wa_custom_msg = section.settings.whatsapp_message | default: wa_default_msg | url_encode
            assign whatsapp_cta_url = 'https://wa.me/' | append: wa_clean_phone | append: '?text=' | append: wa_custom_msg
          -%}

          {%- if section.settings.show_divider -%}
            <hr class="talon-product-showcase__divider">
          {%- endif -%}

          {%- comment -%} Key Product Features & Manufacturing Capabilities List {%- endcomment -%}
          <ul class="talon-product-showcase__features {% if section.settings.feature_columns == '2' %}talon-product-showcase__features--grid{% endif %}">
            {%- if feature_blocks.size > 0 -%}
              {%- for block in feature_blocks -%}
                <li class="talon-product-showcase__feature-item" {{ block.shopify_attributes }}>
                  <span class="talon-product-showcase__feature-badge" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'droplet' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                        </svg>
                      {%- when 'waves' or 'wind' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 8c2.5-2 5-2 7.5 0s5 2 7.5 0"></path>
                          <path d="M4 12c2.5-2 5-2 7.5 0s5 2 7.5 0"></path>
                          <path d="M4 16c2.5-2 5-2 7.5 0s5 2 7.5 0"></path>
                        </svg>
                      {%- when 'pencil' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                        </svg>
                      {%- when 'gear' or 'factory' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="3"></circle>
                          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                      {%- when 'box' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                          <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                      {%- when 'palette' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21a9 9 0 1 0-9-9c0 1.48.5 2.5 1.5 3 .6.3 1.5.5 1.5 1.5 0 .8-.7 1.5-1.5 1.5-.6 0-1 .4-1 1 0 1.1 3.1 2 8 2z"></path>
                          <circle cx="7.5" cy="10.5" r="1.2" fill="currentColor"></circle>
                          <circle cx="12" cy="7.5" r="1.2" fill="currentColor"></circle>
                          <circle cx="16.5" cy="10.5" r="1.2" fill="currentColor"></circle>
                        </svg>
                      {%- when 'check' -%}
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3.5 8.5 6.5 11.5 12.5 5"></polyline>
                        </svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                      {%- else -%}
                        <span class="talon-product-showcase__feature-dot"></span>
                    {%- endcase -%}
                  </span>
                  <div class="talon-product-showcase__feature-content">
                    <span class="talon-product-showcase__feature-title">{{ block.settings.title | escape }}</span>
                    {%- if block.settings.description != blank -%}
                      <p class="talon-product-showcase__feature-desc">{{ block.settings.description | escape }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endfor -%}

            {%- else -%}
              {%- comment -%} Default 6 features matching the reference mockup {%- endcomment -%}
              <li class="talon-product-showcase__feature-item">
                <span class="talon-product-showcase__feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                  </svg>
                </span>
                <div class="talon-product-showcase__feature-content">
                  <span class="talon-product-showcase__feature-title">Quick Dry Fabric</span>
                </div>
              </li>
              <li class="talon-product-showcase__feature-item">
                <span class="talon-product-showcase__feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 8c2.5-2 5-2 7.5 0s5 2 7.5 0"></path>
                    <path d="M4 12c2.5-2 5-2 7.5 0s5 2 7.5 0"></path>
                    <path d="M4 16c2.5-2 5-2 7.5 0s5 2 7.5 0"></path>
                  </svg>
                </span>
                <div class="talon-product-showcase__feature-content">
                  <span class="talon-product-showcase__feature-title">Breathable Material</span>
                </div>
              </li>
              <li class="talon-product-showcase__feature-item">
                <span class="talon-product-showcase__feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                  </svg>
                </span>
                <div class="talon-product-showcase__feature-content">
                  <span class="talon-product-showcase__feature-title">Custom Logo Accepted</span>
                </div>
              </li>
              <li class="talon-product-showcase__feature-item">
                <span class="talon-product-showcase__feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                  </svg>
                </span>
                <div class="talon-product-showcase__feature-content">
                  <span class="talon-product-showcase__feature-title">OEM &amp; ODM Supported</span>
                </div>
              </li>
              <li class="talon-product-showcase__feature-item">
                <span class="talon-product-showcase__feature-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                </span>
                <div class="talon-product-showcase__feature-content">
                  <span class="talon-product-showcase__feature-title">Low MOQ Available</span>
                </div>
              </li>
              <li class="talon-product-showcase__feature-item">
                <span class="talon-product-showcase__feature-badge" aria-hidden="true">
