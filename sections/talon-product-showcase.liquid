  {%- comment -%} ==========================================
      Full-Screen Zoom Lightbox Modal
      ========================================== {%- endcomment -%}
  {%- if section.settings.enable_lightbox -%}
    <div class="talon-ps-lightbox" id="TalonLightbox-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="talon-ps-lightbox__container">
        <button type="button" class="talon-ps-lightbox__close" data-lightbox-close aria-label="Close zoom modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <button type="button" class="talon-ps-lightbox__nav talon-ps-lightbox__nav--prev" data-lightbox-prev aria-label="Previous image">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <img src="" alt="" class="talon-ps-lightbox__img" data-lightbox-image>

        <button type="button" class="talon-ps-lightbox__nav talon-ps-lightbox__nav--next" data-lightbox-next aria-label="Next image">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="talon-ps-lightbox__counter" data-lightbox-counter>1 / 5</div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    function initTalonShowcase() {
      const section = document.getElementById('TalonShowcase-{{ section.id }}');
      if (!section) return;

      const mainCard = section.querySelector('[data-gallery-main]');
      const mainImg = section.querySelector('[data-main-display-image]');
      const prevBtn = section.querySelector('[data-nav-prev]');
      const nextBtn = section.querySelector('[data-nav-next]');
      const counterPill = section.querySelector('[data-gallery-counter]');
      const thumbItems = section.querySelectorAll('.talon-product-showcase__thumb-item');
      const enableLightbox = {{ section.settings.enable_lightbox | json }};
      const lightbox = document.getElementById('TalonLightbox-{{ section.id }}');

      const images = [];
      thumbItems.forEach(thumb => {
        images.push({
          src: thumb.getAttribute('data-full-src') || '',
          alt: thumb.getAttribute('data-alt') || ''
        });
      });

      if (images.length === 0 && mainImg) {
        images.push({ src: mainImg.src, alt: mainImg.alt || '' });
      }

      const total = images.length;
      let currentIndex = 0;

      function goToIndex(newIndex) {
        if (total === 0) return;
        currentIndex = (newIndex + total) % total;

        // Smooth image switch
        if (mainImg && images[currentIndex]) {
          mainImg.classList.add('talon-product-showcase__image--swapping');
          setTimeout(() => {
            mainImg.src = images[currentIndex].src;
            mainImg.alt = images[currentIndex].alt;
            mainImg.classList.remove('talon-product-showcase__image--swapping');
          }, 120);
        }

        // Update counter pill (1/5)
        if (counterPill) {
          counterPill.textContent = (currentIndex + 1) + '/' + total;
        }

        // Update active thumbnail border
        thumbItems.forEach((thumb, idx) => {
          if (idx === currentIndex) {
            thumb.classList.add('is-active');
            thumb.setAttribute('aria-current', 'true');
          } else {
            thumb.classList.remove('is-active');
            thumb.removeAttribute('aria-current');
          }
        });

        // Sync lightbox if open
        if (lightbox && lightbox.classList.contains('is-open')) {
          const lbImg = lightbox.querySelector('[data-lightbox-image]');
          const lbCounter = lightbox.querySelector('[data-lightbox-counter]');
          if (lbImg) lbImg.src = images[currentIndex].src;
          if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + total;
        }
      }

      // Chevron buttons
      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          goToIndex(currentIndex - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          goToIndex(currentIndex + 1);
        });
      }

      // Thumbnails click and keyboard support
      thumbItems.forEach((thumb, idx) => {
        thumb.addEventListener('click', function() {
          goToIndex(idx);
        });
        thumb.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            goToIndex(idx);
          }
        });
      });

      // Touch swipe gestures on mobile
      if (mainCard) {
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;

        mainCard.addEventListener('touchstart', function(e) {
          if (e.changedTouches && e.changedTouches[0]) {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
          }
        }, { passive: true });

        mainCard.addEventListener('touchend', function(e) {
          if (e.changedTouches && e.changedTouches[0]) {
            touchEndX = e.changedTouches[0].screenX;
            touchEndY = e.changedTouches[0].screenY;
            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;
            if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
              if (diffX < 0) {
                goToIndex(currentIndex + 1); // Swiped left -> next
              } else {
                goToIndex(currentIndex - 1); // Swiped right -> prev
              }
            }
          }
        }, { passive: true });
      }

      // Lightbox Modal
      if (enableLightbox && lightbox) {
        const lbImg = lightbox.querySelector('[data-lightbox-image]');
        const lbCounter = lightbox.querySelector('[data-lightbox-counter]');
        const closeBtn = lightbox.querySelector('[data-lightbox-close]');
        const lbPrevBtn = lightbox.querySelector('[data-lightbox-prev]');
        const lbNextBtn = lightbox.querySelector('[data-lightbox-next]');
        const zoomTrigger = section.querySelector('[data-lightbox-trigger]');

        function openLightbox(index) {
          goToIndex(index);
          if (lbImg) lbImg.src = images[currentIndex].src;
          if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + total;
          lightbox.classList.add('is-open');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          lightbox.classList.remove('is-open');
          lightbox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (zoomTrigger) {
          zoomTrigger.addEventListener('click', function(e) {
            e.stopPropagation();
            openLightbox(currentIndex);
          });
        }

        if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

        lightbox.addEventListener('click', function(e) {
          if (e.target === lightbox) closeLightbox();
        });

        if (lbPrevBtn) {
          lbPrevBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            goToIndex(currentIndex - 1);
          });
        }

        if (lbNextBtn) {
          lbNextBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            goToIndex(currentIndex + 1);
          });
        }

        document.addEventListener('keydown', function(e) {
          if (!lightbox.classList.contains('is-open')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') goToIndex(currentIndex - 1);
          if (e.key === 'ArrowRight') goToIndex(currentIndex + 1);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTalonShowcase);
    } else {
      initTalonShowcase();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initTalonShowcase();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "TALON Product Showcase",
  "tag": "section",
  "class": "shopify-section--talon-product-showcase",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Eyebrow",
      "default": "PREMIUM TECHNICAL APPAREL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Product Heading",
      "default": "Soft Breathable | Windproof Water Repellent Multi-Functional Jacket"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show subtle divider line",
      "default": false
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>An essential multi-season outer layer for every wardrobe.</p>"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Gallery Position (Desktop)",
      "options": [
        { "value": "gallery_left", "label": "Gallery Left, Info Right" },
        { "value": "gallery_right", "label": "Info Left, Gallery Right" }
      ],
      "default": "gallery_left"
    },
    {
      "type": "select",
      "id": "desktop_split",
      "label": "Desktop Column Split Ratio",
      "options": [
        { "value": "60-40", "label": "60% Gallery / 40% Info (Recommended)" },
        { "value": "55-45", "label": "55% Gallery / 45% Info" },
        { "value": "50-50", "label": "50% Gallery / 50% Info" },
        { "value": "65-35", "label": "65% Gallery / 35% Info" }
      ],
      "default": "60-40"
    },
    {
      "type": "select",
      "id": "gallery_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "gallery_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gallery Items Gap",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Image Card Border Radius",
      "default": 10
    },
    {
      "type": "select",
      "id": "feature_columns",
      "label": "Feature List Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Interactive Features"
    },
    {
      "type": "checkbox",
      "id": "enable_image_swap",
      "label": "Click thumbnail to swap main image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable full-screen lightbox zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Fallback Images (When no blocks added)"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main Featured Image (Left)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Supporting Image 1 (Top-Left of 2x2)"
