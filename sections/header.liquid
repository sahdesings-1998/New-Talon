<script>
  (() => {
    const navItems = Array.from(document.querySelectorAll('.ip-shop-nav-item'));
    if (!navItems.length) return;

    const hoverNoneMedia = window.matchMedia('(hover: none)');

    const getFocusable = (container) => {
      const nodes = container.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])');
      return Array.from(nodes).filter((el) => !el.hasAttribute('disabled') && !el.getAttribute('aria-hidden'));
    };

    const closeItem = (navItem, returnFocus = false) => {
      navItem.classList.remove('is-active');
      const trigger = navItem.querySelector('.ip-shop-trigger');
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger.focus();
      }
    };

    const openItem = (navItem) => {
      navItem.classList.add('is-active');
      const trigger = navItem.querySelector('.ip-shop-trigger');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
    };

    navItems.forEach((navItem) => {
      const trigger = navItem.querySelector('.ip-shop-trigger');
      const menu = navItem.querySelector('.ip-shop-mega-menu');
      if (!trigger || !menu) return;
      let closeTimer;

      const clearCloseTimer = () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }
      };

      const onFocusIn = () => {
        if (!hoverNoneMedia.matches) openItem(navItem);
      };

      const onFocusOut = (event) => {
        if (!hoverNoneMedia.matches && !navItem.contains(event.relatedTarget)) {
          closeItem(navItem);
        }
      };

      const onMouseEnter = () => {
        if (!hoverNoneMedia.matches) {
          clearCloseTimer();
          openItem(navItem);
        }
      };

      const onMouseLeave = () => {
        if (!hoverNoneMedia.matches) {
          clearCloseTimer();
          closeTimer = setTimeout(() => closeItem(navItem), 180);
        }
      };

      trigger.addEventListener('click', (event) => {
        if (!hoverNoneMedia.matches) return;

        event.preventDefault();
        const isActive = navItem.classList.contains('is-active');
        if (isActive) {
          closeItem(navItem);
        } else {
          openItem(navItem);
        }
      });

      navItem.addEventListener('mouseenter', onMouseEnter);
      navItem.addEventListener('mouseleave', onMouseLeave);
      menu.addEventListener('mouseenter', clearCloseTimer);
      menu.addEventListener('mouseleave', onMouseLeave);
      navItem.addEventListener('focusin', onFocusIn);
      navItem.addEventListener('focusout', onFocusOut);

      navItem.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeItem(navItem, true);
          return;
        }

        if (event.key !== 'Tab' || !navItem.classList.contains('is-active')) return;

        const focusable = [trigger, ...getFocusable(menu)].filter(Boolean);
        if (!focusable.length) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        const current = document.activeElement;

        if (event.shiftKey && current === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && current === last) {
          event.preventDefault();
          first.focus();
        }
      });
    });

    document.addEventListener('pointerdown', (event) => {
      navItems.forEach((navItem) => {
        if (navItem.classList.contains('is-active') && !navItem.contains(event.target)) {
          closeItem(navItem);
        }
      });
    });
  })();
</script>

