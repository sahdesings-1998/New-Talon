<script>
  (() => {
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

    const urlMap = {
      home: '/',
      shop: '/collections',
      oem: '/pages/oem-odm',
      about: '/pages/about-us-page',
      blog: '/pages/blog-posts',
      contact: '/pages/contact-us',
    };

    document.querySelectorAll('.header__primary-nav-item').forEach((item) => {
      const slot = item.getAttribute('data-nav-slot');
      const linkPath = urlMap[slot];
      if (!linkPath) return;

      const isActive =
        linkPath === '/'
          ? currentPath === '/'
          : currentPath === linkPath || currentPath.startsWith(linkPath + '/');

      if (isActive) item.classList.add('nav-item--active');
    });
  })();
</script>


