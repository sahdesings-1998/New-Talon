              src="{{ section.settings.certificate_image_1 | image_url: width: 700 }}"
              alt="Certificate 1"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=700&auto=format&fit=crop"
              alt="Certificate 1"
            >
          {% endif %}
          <span>{{ section.settings.certificate_text_1 }}</span>
        </div>

        <div class="cp-cert-item">
          {% if section.settings.certificate_image_2 != blank %}
