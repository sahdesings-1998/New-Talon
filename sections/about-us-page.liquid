<style>
      /* ════════════════════════════════════════════════════════
     image popup
  ════════════════════════════════════════════════════════ */

  {% comment %} .cp-top-container{
  padding: var(--cp-pad-y-top) var(--cp-pad-x) 0 !important;
  } {% endcomment %}
  .cp-cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .cp-cert-item {
    text-align: center;
  }

  .cp-cert-item img {
    width: 100%;
    display: block;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .cp-cert-item img:hover {
    transform: scale(1.02);
  }

  .cp-cert-item span {
    display: block;
    margin-top: 10px;
    font-size: 16px;
    font-weight: 500;
  }

  /* Popup */
  .cp-image-popup {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: 0.3s ease;
    z-index: 9999;
    padding: 20px;
  }

  .cp-image-popup.active {
    opacity: 1;
    visibility: visible;
  }

  .cp-popup-content {
    max-width: 90%;
    max-height: 90vh;
    border-radius: 14px;
    background: #fff;
  }

  .cp-popup-close {
    position: absolute;
    top: 20px;
    right: 30px;
    color: #fff;
    font-size: 42px;
    cursor: pointer;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    .cp-cert-grid {
      grid-template-columns: 1fr;
    }
  }

