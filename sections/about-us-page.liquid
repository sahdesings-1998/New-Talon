  <!--
    ═══════════════════════════════════════
         COMMITMENT TO SUSTAINABILITY
    ═══════════════════════════════════════
  -->
  <div class="cp-container" id="sustainability">
    <div class="cp-commit-heading">{{ section.settings.commitment_heading }}</div>

    <div class="cp-commit-wrapper">
      <!-- Row 1: text left | image right -->
      <div class="cp-commit-row">
        <div class="cp-commit-text-col">
          <div class="cp-commit-text">{{ section.settings.commitment_Top_text }}</div>
        </div>
        <div class="cp-commit-img-col">
          {% if section.settings.commitment_Top_image != blank %}
            <img
              src="{{ section.settings.commitment_Top_image | image_url: width: 900 }}"
              alt="Commitment"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1497436072909-f5e4be8c8e1e?w=900&auto=format&fit=crop"
              alt="Commitment"
            >
          {% endif %}
        </div>
      </div>

      <!-- Row 2: image left | text right -->
      <div class="cp-commit-row cp-commit-row--reverse">
        <div class="cp-commit-text-col">
          <div class="cp-commit-text">{{ section.settings.commitment_text }}</div>
        </div>
        <div class="cp-commit-img-col">
          {% if section.settings.commitment_image != blank %}
            <img
              src="{{ section.settings.commitment_image | image_url: width: 900 }}"
              alt="Commitment"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1497436072909-f5e4be8c8e1e?w=900&auto=format&fit=crop"
              alt="Commitment"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!--
    ═══════════════════════════════════════
         BOTTOM BANNER
    ═══════════════════════════════════════
  -->
  <div class="cp-container">
    <div class="cp-bottom-banner">
      {% if section.settings.bottom_banner != blank %}
        <img
          src="{{ section.settings.bottom_banner | image_url: width: 1600 }}"
          alt="Banner"
          loading="lazy"
        >
      {% else %}
        <img
          src="https://images.unsplash.com/photo-1620714223084-8fcacc2dbed5?w=1600&auto=format&fit=crop"
          alt="Banner"
        >
      {% endif %}
      <div class="cp-banner-content">
        <h2 class="cp-banner-title">{{ section.settings.banner_title }}</h2>
        <ul class="cp-banner-list">
          {% if section.settings.banner_point_1 != blank %}
            <li>{{ section.settings.banner_point_1 }}</li>
          {% endif %}
          {% if section.settings.banner_point_2 != blank %}
            <li>{{ section.settings.banner_point_2 }}</li>
          {% endif %}
          {% if section.settings.banner_point_3 != blank %}
            <li>{{ section.settings.banner_point_3 }}</li>
          {% endif %}
          {% if section.settings.banner_point_4 != blank %}
            <li>{{ section.settings.banner_point_4 }}</li>
          {% endif %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const popup = document.querySelector('.cp-image-popup');
    const popupImg = document.querySelector('.cp-popup-content');
    const closeBtn = document.querySelector('.cp-popup-close');

    document.querySelectorAll('.cp-popup-image').forEach((img) => {
      img.addEventListener('click', function () {
        popup.classList.add('active');
        popupImg.src = this.src;
      });
    });

    closeBtn.addEventListener('click', function () {
      popup.classList.remove('active');
    });

    popup.addEventListener('click', function (e) {
      if (e.target === popup) {
        popup.classList.remove('active');
      }
    });
  });
</script>

<!--
