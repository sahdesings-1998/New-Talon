<section class="cp-section">
  <!--
    ═══════════════════════════════════════
         COMPANY PROFILE
    ═══════════════════════════════════════
  -->
  <div class="cp-container cp-top-container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">About Us</span>
    </nav>

    <div class="cp-profile-box">
      <h2 class="cp-profile-title cp-profile-titl-heading">{{ section.settings.profile_title }}</h2>
      <div class="cp-profile-text">{{ section.settings.profile_text }}</div>
    </div>
  </div>

  <!--
    ═══════════════════════════════════════
         OUR FACTORY
    ═══════════════════════════════════════
  -->
  <div class="cp-container">
    <div class="cp-factory-wrap">
      <div class="cp-factory-header">
        <span class="cp-profile-title" id="our-factory">{{ section.settings.factory_small }}</span>
      </div>

      <!-- Row 1: text left | image right -->
      <div class="cp-factory-row">
        <div class="cp-factory-text">
          <h2 class="cp-profile-title">{{ section.settings.work_title }}</h2>
          <div class="cp-profile-text">
            <p>{{ section.settings.work_text }}</p>
          </div>
        </div>
        <div class="cp-factory-img">
          {% if section.settings.work_image != blank %}
            <img
              src="{{ section.settings.work_image | image_url: width: 900 }}"
              alt="Factory"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=900&auto=format&fit=crop"
              alt="Factory"
            >
          {% endif %}
        </div>
      </div>

      <!-- Row 2: image left | text right -->
      <div class="cp-factory-row cp-swap-mobile">
        <div class="cp-factory-img">
          {% if section.settings.capacity_image != blank %}
            <img
              src="{{ section.settings.capacity_image | image_url: width: 900 }}"
              alt="Capacity"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1605810230434-7631ac76ec81?w=900&auto=format&fit=crop"
              alt="Capacity"
            >
          {% endif %}
        </div>
        <div class="cp-factory-text cp-text-center">
          <h3>{{ section.settings.capacity_title }}</h3>
          <div>{{ section.settings.capacity_text }}</div>
        </div>
      </div>

      <!-- Row 3: Quality Control — text left | gallery right -->
      <div class="cp-quality-grid" id="production-process">
        <div class="cp-quality-text">
          <h3>{{ section.settings.quality_title }}</h3>
          <div>{{ section.settings.quality_text }}</div>
        </div>
        <div class="cp-quality-images">
          <div class="cp-gallery-col">
            <div class="cp-gallery-item">
              {% if section.settings.gallery_image_1 != blank %}
                <img
                  src="{{ section.settings.gallery_image_1 | image_url: width: 600 }}"
                  alt="Quality 1"
                  loading="lazy"
                >
              {% else %}
                <img
                  src="https://images.unsplash.com/photo-1524522173746-f628baad3644?w=600&auto=format&fit=crop"
                  alt="Quality 1"
                >
              {% endif %}
            </div>
            <div class="cp-gallery-item">
              {% if section.settings.gallery_image_2 != blank %}
                <img
                  src="{{ section.settings.gallery_image_2 | image_url: width: 600 }}"
                  alt="Quality 2"
                  loading="lazy"
                >
              {% else %}
                <img
                  src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&auto=format&fit=crop"
                  alt="Quality 2"
                >
              {% endif %}
            </div>
          </div>
          <div class="cp-gallery-col cp-gallery-col--center">
            <div class="cp-gallery-item">
              {% if section.settings.gallery_image_3 != blank %}
                <img
                  src="{{ section.settings.gallery_image_3 | image_url: width: 600 }}"
                  alt="Quality 3"
                  loading="lazy"
                >
              {% else %}
                <img
                  src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=600&auto=format&fit=crop"
                  alt="Quality 3"
                >
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--
    ═══════════════════════════════════════
         QUALIFICATION CERTIFICATE
    ═══════════════════════════════════════
  -->
