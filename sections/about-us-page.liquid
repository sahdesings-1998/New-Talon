              alt="Certificate 2"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=700&auto=format&fit=crop"
              alt="Certificate 2"
            >
          {% endif %}
          <span>{{ section.settings.certificate_text_2 }}</span>
        </div>

        <div class="cp-cert-item">
          {% if section.settings.certificate_image_3 != blank %}
            <img
              src="{{ section.settings.certificate_image_3 | image_url: width: 700 }}"
              alt="Certificate 3"
              loading="lazy"
            >
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=700&auto=format&fit=crop"
              alt="Certificate 3"
            >
          {% endif %}
          <span>{{ section.settings.certificate_text_3 }}</span>
        </div>

      </div>
    </div>
  {% endcomment %}

  <div class="cp-container" id="certifications">
    <div class="cp-cert-heading">{{ section.settings.certificate_heading }}</div>

    <div class="cp-cert-grid">
      <div class="cp-cert-item">
        {% if section.settings.certificate_image_1 != blank %}
          <img
            src="{{ section.settings.certificate_image_1 | image_url: width: 900 }}"
            alt="Certificate 1"
