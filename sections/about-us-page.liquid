            src="{{ section.settings.certificate_image_2 | image_url: width: 900 }}"
            alt="Certificate 2"
            loading="lazy"
            class="cp-popup-image"
          >
        {% endif %}
        <span>{{ section.settings.certificate_text_2 }}</span>
      </div>

