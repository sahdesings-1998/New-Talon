{%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}

<section class="oem-page talon-faq-section">
  <div class="oem-wrap talon-faq-wrap">
    <div class="talon-stats-bar">
      <div class="talon-stat-item">
        <span class="talon-stat-title">{{ section.settings.stat1_title }}</span>
        <span class="talon-stat-sub">{{ section.settings.stat1_sub }}</span>
      </div>

      <div class="talon-stat-divider"></div>

      <div class="talon-stat-item">
        <span class="talon-stat-title">{{ section.settings.stat2_title }}</span>
        <span class="talon-stat-sub">{{ section.settings.stat2_sub }}</span>
      </div>

      <div class="talon-stat-divider"></div>

      <div class="talon-stat-item">
        <span class="talon-stat-title">{{ section.settings.stat3_title }}</span>
        <span class="talon-stat-sub">{{ section.settings.stat3_sub }}</span>
      </div>
    </div>

    <h2 class="talon-faq-heading " id="faq">{{ section.settings.faq_heading }}</h2>

    <div class="oem-faq talon-faq-list">
      {%- for block in faq_blocks -%}
        <details
          {% if block.settings.open_by_default %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary>{{ block.settings.question }}</summary>
          <div class="oem-faq-answer rte">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}

      {%- if section.settings.faq_support_text != blank -%}
        <p class="oem-faq__support">{{ section.settings.faq_support_text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  
.talon-faq-list .oem-faq-answer {
  max-height: 0;
  overflow: hidden;
  opacity: 0;

  transition:
    max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.3s ease;

  will-change: max-height;
}

.talon-faq-list details[open] .oem-faq-answer {
  max-height: 2000px;
  opacity: 1;
}

</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const details = document.querySelectorAll('.talon-faq-list details');

  details.forEach(item => {
    const summary = item.querySelector('summary');

    summary.addEventListener('click', function(e) {
      e.preventDefault();

      const isOpen = item.hasAttribute('open');

      details.forEach(other => {
        other.removeAttribute('open');
      });

      if (!isOpen) {
        item.setAttribute('open', '');
      }
    });
  });
});
</script>

