{% comment %}
  Custom Garment Block
{% endcomment %}

<div class="garment-block" style="margin-top: 2rem;">
  {% if block.settings.heading != blank %}
    <h3>{{ block.settings.heading }}</h3>
  {% endif %}
  {% if block.settings.description != blank %}
    <p>{{ block.settings.description }}</p>
  {% endif %}
  {% if block.settings.image != blank %}
    <div style="margin-top: 1rem;">
      <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.heading }}" style="max-width: 100%;">
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Garment Details",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Garment Details"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "This product is made from 100% organic cotton. It’s soft, breathable, and ideal for all seasons."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Garment Image"
    }
  ]
}
{% endschema %}
